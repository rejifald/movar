# fallow's local working dir (snapshots, caches), written by `pnpm metrics`.
# Git ignores it through .fallow/.gitignore, but prettier reads only the ROOT
# .gitignore, so without this entry every metrics run leaves a fresh unformatted
# snapshot behind and reddens `format:check`. Its sibling .metrics/ needs no
# entry — that one IS in the root .gitignore.
.fallow

# Real-world HTML fixtures must remain byte-preserving for parser regressions.
**/*.fixture.html

# Generated by scripts/gen-theme-css.mts from @movar/theme's typed tokens —
# prettier would fight the generator's formatting (and the check:theme guard).
packages/theme/styles
