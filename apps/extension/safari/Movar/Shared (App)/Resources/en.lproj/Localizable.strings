/*
  Localizable.strings (English — the development region)
  Shared (App)

  The native About screen's copy. Hand-synced, key for key, with
  `apps/safari-host-app/src/i18n/messages-en.ts`: the keys ARE that catalogue's
  paths, so a drift is a diff rather than a search.

  Only the strings the ported About tab needs are here. Detector / Audit /
  Settings are still React and still read `messages-en.ts` inside the WebView;
  their strings move when those tabs do. `docs/native-shells.md` ("i18n moves
  native") ends with these files being GENERATED from the TS catalogues at build
  time — until that generator exists this pair is written by hand, which is why
  it is deliberately small.

  Ukrainian lives in `uk.lproj/Localizable.strings`; a key missing there falls
  back to this file.
*/

/* --- Tab bar ---------------------------------------------------------- */

"tabs.detector" = "Detector";
"tabs.audit" = "Audit";
"tabs.settings" = "Settings";
"tabs.about" = "About";

/* --- About: lede + product summary ------------------------------------ */

"about.lede" = "Keep the internet in your language.";
"about.summary" = "Movar opens sites in Ukrainian, switches pages away from Russian where a site offers a choice, and can hide unwanted languages right on the page — automatically.";

/* --- About: "What Movar does" ----------------------------------------- */

"about.whatTitle" = "What Movar does";

"about.feature1.title" = "Opens sites in your language";
"about.feature1.desc" = "Asks every site for Ukrainian first, then English.";

"about.feature2.title" = "Switches away from Russian";
"about.feature2.desc" = "When a site has several languages and hands you a blocked one, Movar switches it to yours.";

"about.feature3.title" = "Hides content — optional";
"about.feature3.desc" = "Hides entries in blocked languages from language switchers and feeds. Off by default.";

/* --- About: footer ----------------------------------------------------- */

"about.sourceCode" = "Source code";

/* React tab only. The native About screen no longer renders a combined stamp:
   the masthead states the version in words and the changelog is its own row. */
"about.versionLink" = "%@ — what's new";

/* Masthead version line. %@ is the bare number ("1.6.2") — no "v" prefix, which
   is jargon a spelled-out word replaces, and which no localization could
   translate. A format string rather than concatenation so a language that puts
   the number first can say so. */
"about.version" = "Version %@";

/* Row opening this build's entry on the public changelog. It carries the version
   as its trailing value, so the row says both "what changed" and "in which
   build" — `about.version` supplies the spoken form for VoiceOver. */
"about.whatsNew" = "What's new";

/* Section headers. Three short groups rather than two loose ones: "What's new"
   is not support, and a header that has to stretch over it would be the kind of
   almost-true label a reader silently corrects. */
"about.groupApp" = "App";
"about.groupSupport" = "Support";
"about.groupLegal" = "Legal";

"feedback" = "Send feedback";

/* Native About only — these three have no `messages-en.ts` counterpart, because
   the React About tab never had rows for them. */
"about.rate" = "Rate Movar";

/* Dismisses the iOS setup card. Phrased as a COMPLETION, not as "hide": iOS has
   no API to tell whether the extension is on, so the reader is the only one who
   knows, and the control should say what they are telling us. */
"about.setupDone" = "I've done this";
"about.privacy" = "Privacy policy";

/* Movar's OWN licence — the row carries "MIT" as its value and links to the
   LICENSE file. Distinct from `about.licenses` below, which is the roll-up of
   what Movar is built ON; the two sit in different sections for that reason. */
"about.license" = "Licence";
"about.licenses" = "Third-party licences";

/* --- Trust row --------------------------------------------------------- */

/* React tab only — the native About screen renders none of these now. Its legal
   section closes with Movar's own MIT line instead, which says something the
   rows above cannot; these three either answered a pre-install question or
   restated the privacy policy that section already links to. All three are still
   mirrored on the store listings and the marketing site, so they are reused
   verbatim rather than reworded. See docs/copy.md — every one of these has to
   stay literally true. */
"trust.free" = "Free";
"trust.openSource" = "Open source";
"trust.privacy" = "Nothing leaves your browser";

/* --- Enablement banner: the Settings path ------------------------------ */

/* Apple's own names for the steps, not Movar's — these label rows the reader is
   about to look for in someone else's UI. `chips.settings` is the modern macOS
   wording; `chips.settingsLegacy` is macOS 12 and earlier. */
"chips.settingsApp" = "Settings";
"chips.apps" = "Apps";
"chips.safari" = "Safari";
"chips.settings" = "Settings";
"chips.settingsLegacy" = "Preferences";
"chips.extensions" = "Extensions";
"chips.movar" = "Movar";

/* Spoken between steps — "Settings then Apps then Safari…". Carries its own
   surrounding spaces; it is joined into a sentence, not laid out. */
"pathThen" = " then ";

/* --- Enablement banner: iOS -------------------------------------------- */

"ios.headline" = "One last step";
"ios.helper" = "Open Movar in the Settings app:";
"ios.action" = "Turn it on, and allow it in Private Browsing too — Movar is open source and nothing leaves your browser, so your private tabs stay private.";

/* --- Enablement banner: macOS ------------------------------------------ */

"macSetup.headline" = "One last step";
"macSetup.helper" = "Turn on Movar in Safari:";

"macOn.headline" = "Movar is on";
"macOn.helper" = "Manage it any time in Safari:";

"openPreferences.label" = "Open Safari Settings";
"openPreferences.legacy" = "Open Safari Preferences";

/* --- Settings ----------------------------------------------------------- */

/* Everything from here down mirrors `packages/i18n/src/messages-en.ts`, NOT the
   host app's own catalogue: the web Settings tab rendered `@movar/options-ui`'s
   sections under `@movar/i18n`, so its copy is the extension's options copy and
   has to stay that. The exceptions are the `settings.*` and `common.*` keys at
   the bottom, which name things only a native screen has. */

"options.priority.title" = "Language priority";
"options.priority.addLabel" = "Add language";

/* The section footer. This is the longer of the two explanations the options
   page carried — `options.priority.intro` says the same rule without the
   examples, and a footer has room for the version that makes it concrete. */
"options.aside.howPriorityWorks" = "Movar asks every site for the first language on your list. If the site has Ukrainian, you get Ukrainian. If it only has English, you get English. If it only has Russian, Movar tries to move you off it.";

"options.pageContent.title" = "Page content";
"contentToggle.label" = "Hide content in blocked languages";
"contentToggle.description" = "In language switchers and feeds";

"concealMode.legend" = "What happens to hidden content";
"concealMode.curtain.label" = "Keep behind a curtain";
"concealMode.curtain.description" = "It stays in place, blurred — click to look";
"concealMode.hide.label" = "Hide";
"concealMode.hide.description" = "It disappears and the page closes the gap";

"options.allowlist.title" = "Sites Movar skips";
"options.allowlist.empty" = "Movar skips no sites yet.";
"options.allowlist.inputLabel" = "Site to skip";
"options.allowlist.addButton" = "Add";
"options.allowlist.errorBadDomain" = "Enter an address like example.com";
"options.allowlist.errorDuplicate" = "Already on the list";

/* The exempt-list footer. Kept over the shorter `options.allowlist.intro`
   because "skip" is the word on this screen that most needs pinning down. */
"options.aside.blockedVsExempt" = "A blocked language makes Movar switch the page away from it. A skipped site is left alone — Movar does nothing there at all.";

/* --- Settings: native-only ---------------------------------------------- */

/* No TS counterpart. The web page's equivalents are parameterised by the
   language name (`Move German up`), because its bare glyph buttons each needed a
   distinct accessible label. These hang off a context menu that is already
   scoped to one row, so the row is the object and the verb stands alone. */
"settings.moveUp" = "Move up";
"settings.moveDown" = "Move down";
"settings.remove" = "Remove";

/* The row that leads to About, which used to be a tab of its own. Names the app
   rather than saying a bare "About", because it is the only row in its section
   and "About" alone reads as a heading. */
"settings.about" = "About Movar";

/* Sheet chrome. "Cancel" abandons a task (adding a language, adding a site);
   "Done" closes something that was only being read (About, on macOS). */
"common.cancel" = "Cancel";
"common.done" = "Done";
