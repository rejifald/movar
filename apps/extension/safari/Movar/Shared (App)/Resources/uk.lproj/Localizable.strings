"about.summary" = "Мовар відкриває сайти українською, перемикає сторінки з російської там, де сайт дає вибір, і може приховувати небажані мови просто на сторінці — автоматично.";

/* --- About: "What Movar does" ----------------------------------------- */

"about.whatTitle" = "Що робить Мовар";

"about.feature1.title" = "Відкриває сайти вашою мовою";
"about.feature1.desc" = "У кожного сайту спершу просить українську, потім англійську.";

"about.feature2.title" = "Перемикає з російської";
"about.feature2.desc" = "Коли сайт має кілька мов і віддає заблоковану, Мовар перемикає сторінку на вашу.";

"about.feature3.title" = "Приховує вміст — необовʼязково";
"about.feature3.desc" = "Приховує записи заблокованими мовами в перемикачах мов і стрічках. За замовчуванням вимкнено.";

/* --- About: footer ----------------------------------------------------- */

"about.sourceCode" = "Вихідний код";

/* Лише для React-вкладки. Нативний екран більше не показує об'єднаного рядка:
   у шапці версія словами, а список змін — окремий рядок. */
"about.versionLink" = "%@ — що нового";

/* Рядок версії в шапці. %@ — самий номер («1.6.2»), без префікса «v»: це жаргон,
   який заміняє слово, і його все одно неможливо перекласти. Формат, а не
   склеювання, — щоб мова могла поставити номер там, де їй треба. */
"about.version" = "Версія %@";

/* Рядок, що відкриває список змін цієї збірки. Версію показано праворуч, тож
   рядок каже і «що змінилося», і «в якій збірці»; `about.version` дає озвучену
   форму для VoiceOver. */
"about.whatsNew" = "Що нового";

/* Заголовки секцій. Три короткі групи, а не дві розмиті: «Що нового» — це не
   підтримка, і заголовок, який довелося б на нього натягнути, був би саме тим
   майже-правдивим написом, який читач подумки виправляє. */
"about.groupApp" = "Застосунок";
"about.groupSupport" = "Підтримка";
"about.groupLegal" = "Правове";

"feedback" = "Надіслати відгук";

/* Лише нативний «Про Мовар» — у `messages-uk.ts` відповідників немає, бо у
   React-вкладці таких рядків не було. */
"about.rate" = "Оцінити Мовар";

/* Ховає картку налаштування на iOS. Сформульовано як ЗАВЕРШЕННЯ, а не «сховати»:
   iOS не має API, щоб дізнатися, чи ввімкнено розширення, тож знає це лише
   читач — і кнопка має казати саме те, що він нам повідомляє. */
"about.setupDone" = "Я це зробив";
"about.privacy" = "Політика приватності";

/* ВЛАСНА ліцензія Мовара — рядок показує «MIT» праворуч і веде до файлу LICENSE.
   Не плутати з `about.licenses` нижче: то перелік того, НА ЧОМУ побудовано
   Мовар. Саме тому вони в різних секціях. */
"about.license" = "Ліцензія";
"about.licenses" = "Ліцензії залежностей";

/* --- Trust row --------------------------------------------------------- */

/* Лише для React-вкладки — нативний екран не показує жодного з них. Його правовий
   блок завершує власний рядок ліцензії MIT, який каже те, чого не кажуть рядки
   вище; ці три або відповідали на питання ще до встановлення, або переказували
   політику приватності, на яку блок і так посилається. Усі три й далі
   продубльовані в описах у крамницях і на сайті, тому використані дослівно.
   Див. docs/copy.md — кожне має лишатися буквально правдивим. */
"trust.free" = "Безкоштовно";
"trust.openSource" = "Відкритий код";
"trust.privacy" = "Нічого не покидає браузер";

