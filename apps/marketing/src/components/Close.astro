---
/*
 * Closing CTA — the final beat before the Footer. Rebuilt from the reference
 * mock's finale: one row, a loop-breaking headline on the left, the install
 * CTA and a deep-dive link on the right. Stacks to heading-then-CTA on
 * narrow screens.
 *
 * This replaces the previous "Have feedback? Join the Discord" panel — that
 * ask now lives only in the Footer's contact row, so it isn't dropped, just
 * no longer duplicated as the page's last word before people are asked to
 * install.
 *
 * The install CTA reuses `DownloadButtons` (browser detection, live store
 * links, the "Soon" state) rather than a static button, so this row can
 * never point at a different target than the Hero's. `anchor={false}`
 * because Hero.astro already renders the page's one `<DownloadButtons>`
 * with `id="download"` — a second one on the same page would duplicate that
 * id (same pattern as GuideCallout.astro / GuideChecklist.astro /
 * GuideChecker.astro).
 *
 * It also takes the Hero's `width="stretch"`, for the same reason it can't
 * take a different target: below `sm` both are the page's one action sitting
 * alone in one stacked column, and a button sized by whatever the detected
 * browser's label measures gave the same phone two install buttons of two
 * different widths. Stretched, they agree with each other and with the
 * column. From `sm` up both revert to label width.
 *
 * The "why this keeps happening" deep-dive link used to sit here beside the
 * install CTA. It now closes the Stakes section instead: this row's one job
 * is to get people installing, and a second link competing with the CTA at
 * the page's last beat sent readers away at exactly the wrong moment. Stakes
 * is also where the question it answers is raised.
 *
 * `close.sectionLead`, `emailLabel` and `discordLabel` are no longer read by
 * anything — that ask lives in the Footer's contact row now. They are left in
 * i18n.ts rather than deleted in the same change that moved the layout.
 */
import { strings, type Locale } from '../i18n';
import DownloadButtons from './DownloadButtons.astro';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = strings[lang].close;
---

<section id="close" class="border-t border-border bg-surface px-6 py-20">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-8 md:flex-row md:items-center md:justify-between"
  >
    <h2
      class="font-display text-4xl font-extrabold tracking-display text-ink-strong sm:text-5xl md:flex-1"
    >
      {t.sectionTitle}
    </h2>
    <div class="flex flex-col items-start gap-4 md:shrink-0">
      <DownloadButtons lang={lang} align="start" anchor={false} width="stretch" />
    </div>
  </div>
</section>
