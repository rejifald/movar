---
/*
 * Closing CTA — the final beat before the Footer. Rebuilt from the reference
 * mock's finale: one row, a loop-breaking headline on the left, the install
 * CTA and a deep-dive link on the right. Stacks to heading-then-CTA on
 * narrow screens.
 *
 * This replaces the previous "Have feedback? Join the Discord" panel — that
 * ask now lives only in the Footer's contact row, so it isn't dropped, just
 * no longer duplicated as the page's last word before people are asked to
 * install.
 *
 * The install CTA reuses `DownloadButtons` (browser detection, live store
 * links, the "Soon" state) rather than a static button, so this row can
 * never point at a different target than the Hero's. `anchor={false}`
 * because Hero.astro already renders the page's one `<DownloadButtons>`
 * with `id="download"` — a second one on the same page would duplicate that
 * id (same pattern as GuideCallout.astro / GuideChecklist.astro /
 * GuideChecker.astro).
 *
 * The deep-dive link reuses `problem.deepDiveLinkLabel` +
 * `localeWhyThisHappensHref`: the mock's closing line repeats the exact
 * "why this keeps happening" link the retired Problem.astro used to place mid-page,
 * rather than inventing a second label for the same destination.
 * Hero.astro reaches across namespaces the same way for its own
 * install-guide link (`strings[lang].installGuide.linkLabel`), so this
 * isn't a new pattern.
 *
 * Open item: `close.sectionTitle` (and the now-unused sectionLead /
 * emailLabel / discordLabel) still hold pre-redesign "Have feedback? Join
 * the Discord" copy as of this writing — i18n.ts is owned by a parallel
 * change. Once that lands, `sectionTitle` should read as a standalone
 * headline (e.g. "Movar breaks this loop. Installing takes a minute.") —
 * this layout has no separate lead paragraph under it.
 */
import { strings, type Locale, localeWhyThisHappensHref } from '../i18n';
import DownloadButtons from './DownloadButtons.astro';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = strings[lang].close;
const deepDiveLabel = strings[lang].problem.deepDiveLinkLabel;
const deepDiveHref = localeWhyThisHappensHref(lang);
---

<section id="close" class="border-t border-border bg-surface px-6 py-20">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-8 md:flex-row md:items-center md:justify-between"
  >
    <h2
      class="font-display text-4xl font-extrabold tracking-display text-ink-strong sm:text-5xl md:flex-1"
    >
      {t.sectionTitle}
    </h2>
    <div class="flex flex-col items-start gap-4 md:shrink-0">
      <DownloadButtons lang={lang} align="start" anchor={false} />
      <a
        href={deepDiveHref}
        class="inline-flex items-center gap-1 text-sm font-semibold text-accent-text hover:underline"
      >
        {deepDiveLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
