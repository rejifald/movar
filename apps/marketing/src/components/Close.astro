---
/*
 * Closing CTA. Sits between Limitations and Footer so the user's last
 * narrative impression is an actionable channel, not a list of things Movar
 * can't do.
 *
 * Two channels, deliberately ranked: Discord is the filled primary — it's the
 * community room, and a public question there can be answered by anyone —
 * while the mailto keeps its outlined treatment for anything that needs a
 * private reply. The footer carries the same Discord link as an icon; this is
 * where we actually ask.
 *
 * Pre-launch: emphasises these two. Once stores go live, this section can be
 * repurposed (or removed) and the Hero downloads will carry the action.
 */
import { DISCORD_URL, FEEDBACK_URL } from '@movar/brand';
import { discordIconPath } from '../lib/social-links';
import { strings, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = strings[lang].close;
---

<section
  id="close"
  class="relative overflow-hidden border-t border-border bg-surface px-6 py-20"
>
  <div class="close-backdrop" aria-hidden="true">
    <span class="close-backdrop__aurora"></span>
    <span class="close-backdrop__glow"></span>
    <span class="close-backdrop__grid"></span>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl">
    <h2 class="font-display text-3xl font-extrabold tracking-display text-ink-strong sm:text-4xl">
      {t.sectionTitle}
    </h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      {t.sectionLead}
    </p>
    <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
      <a
        href={DISCORD_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-accent bg-accent px-6 py-4 text-base font-semibold text-accent-on shadow-sm transition hover:shadow-md"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-5 shrink-0">
          <path d={discordIconPath} />
        </svg>
        {t.discordLabel}
      </a>
      <a
        href={FEEDBACK_URL}
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-accent bg-surface px-6 py-4 text-base font-semibold text-accent shadow-sm transition hover:bg-accent-surface hover:shadow-md"
      >
        {t.emailLabel}
      </a>
    </div>
  </div>
</section>
