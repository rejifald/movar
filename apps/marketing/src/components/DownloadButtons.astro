---
/*
 * The install CTA. The visitor doesn't pick a store — we detect their browser
 * and point the button at the matching marketplace, with a GitHub-releases
 * fallback so unrecognised browsers still have a target.
 *
 * A page may render this more than once (the guide hub carries one in the
 * diagnosis and one in the checklist), so nothing here may assume it is the
 * only instance: the script resolves every `[data-cta]`, the Android note is
 * found through the instance's own `[data-cta-root]`, and `id="download"` is
 * opt-out via `anchor`.
 *
 * The button is always enabled (never greyed out). Per-browser states the
 * script lands on:
 * - Detected browser, store live      → enabled link to the store. On the
 *                                        browsers where the store page alone
 *                                        leaves the visitor stuck (Edge,
 *                                        Safari, iOS Safari) the store opens in
 *                                        a new tab and THIS tab follows on to
 *                                        the /install guide — see
 *                                        ../lib/install-handoff for why that
 *                                        split, and never both at once.
 * - Detected browser, store not live  → enabled but inert (no href + no-op
 *                                        click), with a "Soon" chip so the
 *                                        visitor knows the listing is pending.
 * - Android on Chromium               → enabled link to AMO, plus the note
 *                                        below the button. Checked BEFORE the
 *                                        detected browser, because there
 *                                        detection is right and useless at the
 *                                        same time: Chrome on Android is
 *                                        Chrome, and no Chromium browser on
 *                                        Android can install an extension, so
 *                                        the store its identity earns it is a
 *                                        button that cannot work. See
 *                                        ../lib/downloads `isAndroidChromium`.
 * - Unrecognised browser              → enabled link to GitHub releases.
 *
 * SSR renders the neutral "Add Movar to your browser" label with the GitHub
 * href so no-JS visitors get a working destination; the inline script swaps
 * in the per-browser label + target once it detects the browser.
 *
 * Store config + browser detection live in ../lib/downloads so this CTA and
 * the header's Download nav link resolve to the same targets.
 *
 * Opera and Brave install Chromium extensions via the Chrome Web Store but
 * keep their own button label. Safari needs its own WebExtension build.
 */

import { FALLBACK_HREF, perBrowser } from '../lib/downloads';
import { browserIconPaths, githubIconPath } from '../lib/browser-icons';
import { localeInstallHref, strings, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
  /**
   * Cross-axis alignment of the button and the Android note under it. Centred
   * by default, because the surfaces this started on — the hero and /install —
   * are centred blocks. Anything sitting inside prose (the guide's CTAs, the
   * blog's closing panel) takes `start`.
   */
  align?: 'center' | 'start';
  /**
   * Whether this instance carries `id="download"`. An id may exist once per
   * document, and since the guide renders several CTAs on one page, only the
   * page's primary one keeps it.
   */
  anchor?: boolean;
  /**
   * Which surface the button sits on. `accent` is the green button on page
   * background. `inverse` is for a filled forest panel, where the green button
   * would be a 1.9:1 shape on its own background — there the button is white
   * with forest text, and the "Soon" chip has to lighten with it.
   */
  tone?: 'accent' | 'inverse';
  /**
   * How wide the button is on narrow screens. `stretch` fills the column below
   * `sm` and reverts to label width from `sm` up; `auto` is label width
   * throughout.
   *
   * Every CTA that is a page's own primary action stretches — Hero.astro,
   * Close.astro and InstallGuide.astro. On a phone each is the one action
   * alone in one stacked column, and its width is whatever the detected
   * browser's label happens to measure: 198px ("Встановити в Edge") to 292px
   * (the Android label) inside the same 312px column at 360px. That gave the
   * homepage two install buttons of two different widths, and gave the same
   * button a different width per visitor, none of them lining up with
   * anything. Filling the column settles them all on the edge the rules, the
   * prose and the claims list already share.
   *
   * `align` is unaffected: it positions the button's contents, so a stretched
   * `center` CTA (/install) still centres its label inside the filled button.
   *
   * Prose callers stay `auto` — the guide's callouts and the blog panel put
   * the button inside a paragraph's measure, where a full-bleed bar reads as a
   * banner rather than as a control.
   */
  width?: 'auto' | 'stretch';
}

const {
  lang = 'en',
  align = 'center',
  anchor = true,
  tone = 'accent',
  width = 'auto',
} = Astro.props;

const TONE = {
  accent: {
    button: 'border-accent bg-accent text-accent-on shadow-sm hover:shadow-md',
    /* Tinted with bg-black/25 (not bg-accent-deep) so the chip stays a darker
     * patch on the green button in both themes. */
    soon: 'rounded-md bg-black/25 px-2 py-1 text-ui-xs font-medium uppercase tracking-label text-accent-on',
  },
  inverse: {
    button: 'border-transparent bg-white text-forest-900 hover:shadow-md',
    soon: 'rounded-md bg-forest-900/15 px-2 py-1 text-ui-xs font-medium uppercase tracking-label text-forest-900',
  },
} as const;

/* Applied to the wrapper as well as the button: the wrapper is a flex item of
 * the caller's row, so without a width of its own it shrinks to the label and
 * the button has nothing to fill. */
const WIDTH = {
  auto: '',
  stretch: 'w-full sm:w-auto',
} as const;

const t = strings[lang].download;
const guideHref = localeInstallHref(lang);
---

<div
  data-cta-root
  id={anchor ? 'download' : undefined}
  class:list={[
    'flex flex-col gap-4',
    align === 'start' ? 'items-start' : 'items-center',
    WIDTH[width],
  ]}
>
  <a
    data-cta
    data-stores={JSON.stringify(perBrowser)}
    data-labels={JSON.stringify(t.add)}
    data-icons={JSON.stringify(browserIconPaths)}
    data-github-icon={githubIconPath}
    data-soon-label={t.soon}
    data-fallback-label={t.viaGithub}
    data-android-label={t.addAndroid}
    data-guide-href={guideHref}
    data-new-tab-label={t.newTab}
    data-soon-class={TONE[tone].soon}
    href={FALLBACK_HREF}
    class:list={[
      'group inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border px-6 py-3 text-sm font-semibold transition',
      TONE[tone].button,
      WIDTH[width],
    ]}
  >
    <span data-cta-label>{t.addGeneric}</span>
  </a>

  {/*
   * Android-only explanation for the button above, which on Chromium there
   * points at Firefox's store rather than the visitor's own. Rendered hidden
   * and revealed by the script, so it costs every other visitor nothing and
   * leaves the visual baselines untouched (a `hidden` child draws nothing, and
   * the wrapper's `gap-4` only spaces children that exist).
   */}
  <p
    data-android-note
    hidden
    class:list={[
      'max-w-prose text-sm text-ink-soft',
      align === 'start' ? 'text-left' : 'text-center',
    ]}
  >
    {t.androidNote}
  </p>
</div>

<script>
  import { detectBrowser, isAndroidChromium, type BrowserId } from '../lib/downloads';
  import { wireInstallGuideHandoff } from '../lib/install-handoff';

  /*
   * Every CTA on the page, not just the first. Astro hoists this script once
   * per document however many times the component renders, so a `querySelector`
   * here left every CTA after the first frozen on its SSR markup — a green
   * "Add Movar to your browser" pointing at GitHub releases. That was invisible
   * while the three original callers each owned their own page; the guide
   * renders up to three (the diagnosis, the checklist and a page's callout).
   */
  const id = detectBrowser();
  for (const cta of document.querySelectorAll<HTMLAnchorElement>('[data-cta]')) {
    const stores = JSON.parse(cta.dataset['stores'] ?? '{}') as Record<
      BrowserId,
      { href: string; liveAt: string | null }
    >;
    const labels = JSON.parse(cta.dataset['labels'] ?? '{}') as Record<BrowserId, string>;
    const icons = JSON.parse(cta.dataset['icons'] ?? '{}') as Record<BrowserId, string>;
    const githubIcon = cta.dataset['githubIcon'] ?? '';
    const soonLabel = cta.dataset['soonLabel'] ?? '';
    const fallbackLabel = cta.dataset['fallbackLabel'] ?? '';
    const androidLabel = cta.dataset['androidLabel'] ?? '';
    const guideHref = cta.dataset['guideHref'] ?? '';
    const newTabLabel = cta.dataset['newTabLabel'] ?? '';
    const labelEl = cta.querySelector<HTMLSpanElement>('[data-cta-label]');

    // Prepend a logo before the label. Built here (not in SSR) so the no-JS /
    // neutral state has no leading icon — gap-2 only kicks in once this sized
    // element exists, avoiding a stray gap before the text.
    const prependIcon = (path: string) => {
      if (!path || !labelEl) return;
      const icon = document.createElement('span');
      icon.setAttribute('aria-hidden', 'true');
      icon.className = 'inline-flex shrink-0';
      icon.innerHTML = `<svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><path d="${path}"/></svg>`;
      labelEl.before(icon);
    };

    if (isAndroidChromium()) {
      // Detection is right and useless here: this really is Chrome (or Edge, or
      // Samsung Internet), and none of them can install an extension on
      // Android, so `stores[id]` would be a Chrome Web Store link that cannot
      // work. Firefox for Android can, and Movar ships an Android build for it,
      // so the CTA offers the one target that installs — with the note below
      // the button carrying the "why is this offering me Firefox" answer.
      //
      // No install-guide handoff: `needsInstallGuide` doesn't flag Firefox, and
      // the guide's steps are desktop flows the note already disowns.
      const firefox = stores['firefox'];
      if (labelEl) labelEl.textContent = androidLabel;
      prependIcon(icons['firefox'] ?? '');
      if (firefox) cta.href = firefox.href;
      // This CTA's own note, not the page's first one — the guide stacks
      // several, and each button needs the answer sitting under it.
      cta
        .closest('[data-cta-root]')
        ?.querySelector('[data-android-note]')
        ?.removeAttribute('hidden');
    } else if (!id) {
      // Unrecognised browser — keep the SSR GitHub href, refresh the label and
      // mark it with the GitHub logo to match "Get Movar from GitHub".
      if (labelEl) labelEl.textContent = fallbackLabel;
      prependIcon(githubIcon);
    } else {
      // Matching browser glyph so the button reads "[Chrome] Add to Chrome".
      if (labelEl) labelEl.textContent = labels[id];
      prependIcon(icons[id]);
      const store = stores[id];
      if (store?.liveAt) {
        cta.href = store.href;
        // Only now that the CTA points at a live store: on Edge/Safari the
        // store page isn't the whole install, so hand this tab off to the guide
        // while the store takes the new one.
        wireInstallGuideHandoff(cta, id, guideHref, newTabLabel);
      } else {
        // Listing isn't live yet — drop the href so the click is a no-op, but
        // keep the button visually enabled and add a "Soon" chip so visitors
        // know it's coming.
        cta.removeAttribute('href');
        if (labelEl) {
          const span = document.createElement('span');
          span.dataset['ctaSoon'] = '';
          // The chip's tint belongs to the surface, not to this script — see
          // `TONE` above. A white button needs a dark chip, a green one needs
          // a darker green.
          span.className = cta.dataset['soonClass'] ?? '';
          span.textContent = soonLabel;
          labelEl.after(span);
        }
      }
    }
  }
</script>
