---
/**
 * The hero's before/after "drum" — a tabbed card cycling four scenarios:
 * Google search, Google's summary card, YouTube, and a Ukrainian shop. Same
 * four scenarios and the same screenshots as the full Examples section
 * further down the page (`strings[lang].examples.entries`, keyed 0-3), so
 * copy, alt text and images stay one source of truth instead of a second
 * copy that can drift.
 *
 * Auto-advances every 4500ms; a click on a tab selects it and restarts the
 * timer. Never auto-advances at all under `prefers-reduced-motion: reduce`
 * (checked in the client script below) — that is a hard requirement, not a
 * "slower" mode. The active tab's 2px underline doubles as a 4500ms
 * progress bar, built from two Tailwind width classes (`w-0` → `w-full`)
 * plus a `transition-[width]` on the fill bar, so a plain class toggle is
 * what animates it; `motion-reduce:transition-none` drops that transition
 * automatically for reduced-motion visitors without any extra JS branch.
 *
 * Progressive enhancement: all four tab labels and the first slide's full
 * before/after pair render at build time; slides 2-4 are `hidden` until the
 * client script runs, so a no-JS visitor still sees one complete example.
 *
 * Screenshot sourcing is lifted from the retired Examples.astro: the same `existsSync`
 * on-disk guard (a missing capture degrades to no image rather than a
 * broken one) and the same dark-mode swap via <picture> +
 * prefers-color-scheme. Duplicated rather than imported — Astro components
 * don't export plain data to one another, and this file owns nothing else
 * in that one.
 *
 * Crop height per screenshot steps down at narrower widths (see `frame*`
 * below): the drum itself gets much narrower on a phone, and a 208px-tall
 * slice of a screenshot scaled down that far reads as a grey smear rather
 * than a legible result.
 */
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';
import { strings, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = strings[lang].examples;

const publicDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../public');

interface ExampleImage {
  src: string;
}
interface ExampleImagePair {
  without: ExampleImage;
  with: ExampleImage;
}

// The four pairs, keyed by index as the retired Examples.astro did — kept here, not
// imported (see file doc above).
const imagePairs: Record<number, ExampleImagePair> = {
  0: {
    without: { src: '/screenshots/google-without-movar.png' },
    with: { src: '/screenshots/google-with-movar.png' },
  },
  1: {
    without: { src: '/screenshots/google-god-of-war-without-movar.png' },
    with: { src: '/screenshots/google-god-of-war-with-movar.png' },
  },
  2: {
    without: { src: '/screenshots/youtube-without-movar.png' },
    with: { src: '/screenshots/youtube-with-movar.png' },
  },
  3: {
    without: { src: '/screenshots/shop-without-movar.png' },
    with: { src: '/screenshots/shop-with-movar.png' },
  },
};

const onDisk = (src: string): boolean => existsSync(path.join(publicDir, src.replace(/^\//, '')));

const darkSrc = (src: string): string => src.replace(/\.png$/, '-dark.png');

interface ResolvedImage {
  src: string;
  alt: string;
  /** Dark-theme sibling, present only when the `-dark` PNG is on disk. */
  dark?: string;
}
interface ResolvedPair {
  without: ResolvedImage;
  with: ResolvedImage;
}

const resolveImage = (img: ExampleImage, alt: string): ResolvedImage => {
  const dark = darkSrc(img.src);
  return onDisk(dark) ? { src: img.src, alt, dark } : { src: img.src, alt };
};

const filesReady = (pair: ExampleImagePair): boolean =>
  onDisk(pair.without.src) && onDisk(pair.with.src);

const imagesFor = (i: number): ResolvedPair | null => {
  const pair = imagePairs[i];
  const alt = t.entries[i]?.alt;
  if (!pair || !alt || !filesReady(pair)) return null;
  return {
    without: resolveImage(pair.without, alt.without),
    with: resolveImage(pair.with, alt.withMovar),
  };
};

interface Slide {
  label: string;
  caption: string;
  images: ResolvedPair | null;
}

/*
 * `t.captions` is the four-line summary shown under the card — one per
 * slide (see `ExamplesStrings.captions` in i18n.ts). Tab labels reuse each
 * entry's own `site` name rather than inventing new copy: short for
 * Google/YouTube, longer for the other two, which is fine since the tab
 * row wraps rather than truncating (see the tablist below).
 */
const slides: Slide[] = [0, 1, 2, 3].map((i) => ({
  label: t.entries[i]?.site ?? '',
  caption: t.captions[i] ?? t.entries[i]?.scenario ?? '',
  images: imagesFor(i),
}));

// Crop window per breakpoint — shorter at mobile/tablet, where the drum is
// much narrower and a tall crop would just show more of the page at a
// smaller, less legible scale rather than the same legible slice.
const frameBefore = 'h-36 overflow-hidden rounded-lg border border-border md:h-40 lg:h-52';
const frameAfter =
  'h-36 overflow-hidden rounded-lg border border-accent/40 ring-4 ring-accent-surface md:h-40 lg:h-52';
---

<div data-example-drum>
  <div class="overflow-hidden rounded-2xl border border-border bg-surface shadow-lg">
    <div
      role="tablist"
      aria-label={t.sectionTitle}
      class="flex flex-wrap gap-x-5 gap-y-3 border-b border-border px-4 pt-3 md:px-5 md:pt-4"
    >
      {
        slides.map((slide, i) => (
          <button
            type="button"
            role="tab"
            id={`drum-tab-${i}`}
            aria-controls={`drum-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-drum-tab
            class="flex flex-col items-start gap-2.5 pb-3 text-left"
          >
            <span
              data-drum-label
              class:list={[
                'text-sm font-semibold tracking-tight',
                i === 0 ? 'text-accent-deep' : 'text-ink-soft',
              ]}
            >
              {slide.label}
            </span>
            <span class="h-0.5 overflow-hidden rounded-full">
              <span
                data-drum-fill
                class:list={[
                  'block h-full rounded-full bg-accent transition-[width] duration-[var(--drum-fill)] ease-linear motion-reduce:transition-none',
                  i === 0 ? 'w-full' : 'w-0',
                ]}
              />
            </span>
          </button>
        ))
      }
    </div>

    <div class="p-3 md:p-4 lg:p-5">
      {
        slides.map((slide, i) => (
          <div
            data-drum-panel
            role="tabpanel"
            id={`drum-panel-${i}`}
            aria-labelledby={`drum-tab-${i}`}
            hidden={i !== 0}
          >
            {slide.images && (
              <div class={frameBefore}>
                <picture>
                  {slide.images.without.dark && (
                    <source srcset={slide.images.without.dark} media="(prefers-color-scheme: dark)" />
                  )}
                  <img
                    src={slide.images.without.src}
                    alt={slide.images.without.alt}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class="block h-full w-full object-cover object-top"
                  />
                </picture>
              </div>
            )}

            {/* What Movar did, set between the two frames — the sentence names
               the action that separates them, so it belongs at the transition
               rather than under the whole card. It is also the only thing
               marking which panel is which: they are stacked before-then-after,
               the order the pair is read in, and the second frame's accent
               border marks it as the result. Alt text keeps the two
               distinguishable for anyone not seeing them.

               Rendered per panel rather than swapped by script — each panel
               owns its own line, so there is no shared node to keep in sync
               with the visible slide. */}
            <div class="my-4 flex justify-center">
              {/* Same branded claim as HowItWorks' step 1: the Movar mark, then
                 what Movar did. `rounded-2xl` rather than `rounded-full`
                 because these lines run to ~50 characters and wrap inside the
                 pill at phone width, where a full radius would read as a
                 lozenge instead of a pill. */}
              <span class="inline-flex min-w-0 items-center gap-2 rounded-2xl border border-accent/30 bg-accent-surface py-1 pl-1 pr-3">
                <img src="/icon.svg" alt="" width="18" height="18" class="shrink-0 rounded-[var(--corner-badge)]" />
                <span class="min-w-0 text-xs font-semibold leading-relaxed text-accent-deep">
                  {slide.caption}
                </span>
              </span>
            </div>

            {slide.images && (
              <div class={frameAfter}>
                <picture>
                  {slide.images.with.dark && (
                    <source srcset={slide.images.with.dark} media="(prefers-color-scheme: dark)" />
                  )}
                  <img
                    src={slide.images.with.src}
                    alt={slide.images.with.alt}
                    loading="lazy"
                    class="block h-full w-full object-cover object-top"
                  />
                </picture>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>

</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-example-drum]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-drum-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-drum-panel]')];
    const fills = [...root.querySelectorAll<HTMLElement>('[data-drum-fill]')];

    const ADVANCE_MS = 4500;

    let reduceMotion = false;
    try {
      reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch {
      reduceMotion = false;
    }

    let index = 0;
    /* `ReturnType<typeof window.setInterval>` resolves to Node's `Timeout` here —
     * @types/node is in scope for the Astro frontmatter, and it wins over lib.dom.
     * This script only ever runs in the browser, where the handle is a number, so
     * say so. Same shape as `ReturnType<typeof setTimeout>` in apps/extension. */
    let timer: number | null = null;

    const setActive = (next: number): void => {
      index = next;

      tabs.forEach((tab, n) => {
        const active = n === next;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        const label = tab.querySelector<HTMLElement>('[data-drum-label]');
        label?.classList.toggle('text-accent-deep', active);
        label?.classList.toggle('text-ink-soft', !active);
      });

      panels.forEach((panel, n) => {
        panel.hidden = n !== next;
      });

      fills.forEach((fill, n) => {
        if (n !== next) {
          fill.classList.remove('w-full');
          fill.classList.add('w-0');
        }
      });

      // Reset-then-reflow-then-fill every time, even when re-selecting the
      // tab that was already active, so its bar restarts too. The
      // transition is dropped under prefers-reduced-motion by the
      // `motion-reduce:transition-none` class above, so this exact same
      // sequence lands instantly there instead of animating — no separate
      // branch needed for that half of the behaviour.
      const activeFill = fills[next];
      if (activeFill) {
        activeFill.classList.remove('w-full');
        activeFill.classList.add('w-0');
        void activeFill.offsetWidth;
        activeFill.classList.remove('w-0');
        activeFill.classList.add('w-full');
      }
    };

    const stop = (): void => {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const start = (): void => {
      stop();
      // Required, not optional: prefers-reduced-motion means no
      // auto-advance at all, not merely a slower one.
      if (reduceMotion) return;
      timer = window.setInterval(() => {
        setActive((index + 1) % tabs.length);
      }, ADVANCE_MS);
    };

    tabs.forEach((tab, n) => {
      tab.addEventListener('click', () => {
        setActive(n);
        start();
      });
    });

    setActive(0);
    start();
  }
</script>
