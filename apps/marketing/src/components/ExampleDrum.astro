---
/**
 * The hero's example "drum" — four tabs, each a real device capture whose
 * screen is split in half: the top half the page WITH Movar, the bottom half
 * the same page WITHOUT it, divided by a thin seam baked into the image at
 * exactly 50% height. The device is drawn in CSS around the bare screen: a
 * phone below `lg`, a tablet from `lg` (the breakpoint where the hero's drum
 * column first reaches ~340px; at `md` it is ~310px, too narrow for a tablet
 * to read as more than a smaller phone). The whole device is shown, never
 * cropped — the bottom half carries the "without" state.
 *
 * Captures live at `public/listing/<device>/<locale>/<slide id>.webp` and
 * arrive in stages, so every lookup goes through the `existsSync` on-disk
 * guard and degrades instead of breaking:
 *   - per slide, the tablet capture is used from `lg` when it exists (one
 *     <img> with a <picture> <source>, so only one file downloads); without
 *     it the phone capture sits in the phone frame at every width;
 *   - a slide with a tablet capture but no phone one shows the tablet frame
 *     at every width;
 *   - a slide with neither is dropped, and with no slides at all the drum
 *     renders nothing.
 *
 * Auto-advances every 4500ms; a click on a tab selects it and restarts the
 * timer. Never auto-advances at all under `prefers-reduced-motion: reduce`
 * (checked in the client script below) — that is a hard requirement, not a
 * "slower" mode. The active tab's 2px underline doubles as a 4500ms progress
 * bar, built from two Tailwind width classes (`w-0` → `w-full`) plus a
 * `transition-[width]` on the fill bar, so a plain class toggle is what
 * animates it; `motion-reduce:transition-none` drops that transition for
 * reduced-motion visitors without any extra JS branch.
 *
 * Progressive enhancement: all tab labels and the first slide render at build
 * time; slides 2-4 are `hidden` until the client script runs, so a no-JS
 * visitor still sees one complete example.
 *
 * The "With Movar" / "Without Movar" captions sit beside the halves they name
 * — vertical, left of the device from `md` (the drum column is too narrow for
 * a horizontal label rail beside a device there), and above / below the
 * device on a phone. They are `aria-hidden`: each slide's alt text already
 * names both halves, top first.
 *
 * `data-drum-tab` / `aria-selected` are read by apps/e2e's visual suite
 * (`assertDrumPinned`) to prove the drum is pinned to slide 1 when it shoots.
 */
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';
import { strings, type DrumSlideId, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = strings[lang].drum;

const publicDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../public');

const SLIDE_IDS: readonly DrumSlideId[] = ['search', 'site-no-modal', 'site-menu', 'youtube'];

type Device = 'iphone' | 'ipad';

/** Pixel size of each device's capture, for `width`/`height` (no layout shift). */
const CAPTURE_SIZE: Record<Device, { width: number; height: number }> = {
  iphone: { width: 720, height: 1564 },
  ipad: { width: 1200, height: 1600 },
};

const onDisk = (src: string): boolean => existsSync(path.join(publicDir, src.replace(/^\//, '')));

const captureSrc = (device: Device, id: DrumSlideId): string | null => {
  const src = `/listing/${device}/${lang}/${id}.webp`;
  return onDisk(src) ? src : null;
};

/**
 * `both`: phone frame below `lg`, tablet frame from `lg`.
 * `phone` / `tablet`: that frame at every width.
 */
type FrameMode = 'both' | 'phone' | 'tablet';

interface Slide {
  label: string;
  alt: string;
  mode: FrameMode;
  /** The <img> fallback — the phone capture, or the tablet one in `tablet` mode. */
  img: { src: string; width: number; height: number };
  /** The tablet capture as a `lg` <source>, in `both` mode only. */
  tabletSource?: { src: string; width: number; height: number };
}

const slides: Slide[] = SLIDE_IDS.flatMap((id): Slide[] => {
  const phone = captureSrc('iphone', id);
  const tablet = captureSrc('ipad', id);
  const { label, alt } = t.slides[id];
  if (phone && tablet) {
    return [
      {
        label,
        alt,
        mode: 'both',
        img: { src: phone, ...CAPTURE_SIZE.iphone },
        tabletSource: { src: tablet, ...CAPTURE_SIZE.ipad },
      },
    ];
  }
  if (phone) return [{ label, alt, mode: 'phone', img: { src: phone, ...CAPTURE_SIZE.iphone } }];
  if (tablet) return [{ label, alt, mode: 'tablet', img: { src: tablet, ...CAPTURE_SIZE.ipad } }];
  return [];
});

/*
 * Frame geometry. Bezel padding is uniform (`p-2` phone, `p-3` tablet) so the
 * seam stays at exactly half the device's height — which is what lets the
 * captions centre on each half. Radii and widths are tokens in global.css.
 */
const bezel = 'border border-border bg-[var(--device-bezel)] shadow-2xl';
const phoneFrame =
  'w-[var(--device-phone-w)] max-w-full rounded-[var(--device-phone-r)] p-2 sm:w-[var(--device-phone-w-sm)]';
const tabletFrame = 'w-full max-w-[var(--device-tablet-w)] rounded-[var(--device-tablet-r)] p-3';
const tabletFrameLg =
  'lg:w-full lg:max-w-[var(--device-tablet-w)] lg:rounded-[var(--device-tablet-r)] lg:p-3';
const phoneScreen = 'rounded-[var(--device-phone-screen-r)]';
const tabletScreen = 'rounded-[var(--device-tablet-screen-r)]';
const tabletScreenLg = 'lg:rounded-[var(--device-tablet-screen-r)]';

const frameClass = (mode: FrameMode): string[] =>
  mode === 'tablet'
    ? [bezel, tabletFrame]
    : mode === 'both'
      ? [bezel, phoneFrame, tabletFrameLg]
      : [bezel, phoneFrame];

const screenClass = (mode: FrameMode): string[] =>
  mode === 'tablet' ? [tabletScreen] : mode === 'both' ? [phoneScreen, tabletScreenLg] : [phoneScreen];

// A tablet anywhere means the device cell should grow to the column (up to
// the tablet cap) rather than hug a fixed-width phone.
const anyTablet = slides.some((slide) => slide.mode !== 'phone');
const allTablet = slides.length > 0 && slides.every((slide) => slide.mode === 'tablet');

/* One caption: a dot, then the label. Vertical (read bottom-to-top) from `md`. */
const captionClass =
  'flex items-center gap-2 whitespace-nowrap text-xs font-semibold tracking-tight md:rotate-180 md:[writing-mode:vertical-rl]';
---

{
  slides.length > 0 && (
    <div data-example-drum class="flex flex-col items-center gap-6">
      <div
        role="tablist"
        aria-label={t.tablistLabel}
        class="flex flex-wrap justify-center gap-x-5 gap-y-3"
      >
        {slides.map((slide, i) => (
          <button
            type="button"
            role="tab"
            id={`drum-tab-${i}`}
            aria-controls={`drum-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-drum-tab
            class="flex flex-col items-start gap-2.5 pb-1 text-left"
          >
            <span
              data-drum-label
              class:list={[
                'text-sm font-semibold tracking-tight',
                i === 0 ? 'text-accent-deep' : 'text-ink-soft',
              ]}
            >
              {slide.label}
            </span>
            <span class="h-0.5 w-full overflow-hidden rounded-full">
              <span
                data-drum-fill
                class:list={[
                  'block h-full rounded-full bg-accent transition-[width] duration-[var(--drum-fill)] ease-linear motion-reduce:transition-none',
                  i === 0 ? 'w-full' : 'w-0',
                ]}
              />
            </span>
          </button>
        ))}
      </div>

      {/*
       * Phone: caption, device, caption — one column. From `md`: a caption
       * rail left of the device, two equal rows so each caption centres on
       * its half (the device spans both).
       */}
      <div
        class:list={[
          'grid w-full justify-items-center gap-3 md:grid-rows-2 md:gap-x-4 md:gap-y-0',
          allTablet
            ? 'md:grid-cols-[auto_minmax(0,1fr)]'
            : anyTablet
              ? 'md:grid-cols-[auto_auto] md:justify-center lg:grid-cols-[auto_minmax(0,1fr)]'
              : 'md:grid-cols-[auto_auto] md:justify-center',
        ]}
      >
        <p
          aria-hidden="true"
          class:list={[captionClass, 'text-ink-strong md:col-start-1 md:row-start-1 md:self-center']}
        >
          <span class="size-2 shrink-0 rounded-full bg-accent" />
          {t.withMovar}
        </p>

        <div class="w-full md:col-start-2 md:row-span-2 md:row-start-1">
          {slides.map((slide, i) => (
            <div
              data-drum-panel
              role="tabpanel"
              id={`drum-panel-${i}`}
              aria-labelledby={`drum-tab-${i}`}
              hidden={i !== 0}
            >
              <div class:list={['mx-auto', ...frameClass(slide.mode)]}>
                <picture>
                  {slide.tabletSource && (
                    <source
                      media="(min-width: 64rem)"
                      srcset={slide.tabletSource.src}
                      width={slide.tabletSource.width}
                      height={slide.tabletSource.height}
                    />
                  )}
                  <img
                    src={slide.img.src}
                    width={slide.img.width}
                    height={slide.img.height}
                    alt={slide.alt}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    class:list={['block h-auto w-full', ...screenClass(slide.mode)]}
                  />
                </picture>
              </div>
            </div>
          ))}
        </div>

        <p
          aria-hidden="true"
          class:list={[captionClass, 'text-ink-soft md:col-start-1 md:row-start-2 md:self-center']}
        >
          <span class="size-2 shrink-0 rounded-full bg-ink-faint" />
          {t.withoutMovar}
        </p>
      </div>
    </div>
  )
}

<script>
  const root = document.querySelector<HTMLElement>('[data-example-drum]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-drum-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-drum-panel]')];
    const fills = [...root.querySelectorAll<HTMLElement>('[data-drum-fill]')];

    const ADVANCE_MS = 4500;

    /*
     * The reduced-motion gate, held live rather than read once.
     *
     * A single boolean sampled at init is wrong twice. For a reader it strands
     * whoever turns the preference on mid-session: the drum keeps advancing
     * under a setting that says it must not. And it makes the gate depend on
     * the media query already being resolved when this module happens to run,
     * which is not something a page script can promise — a capture harness
     * that sets the preference for the run gets a drum that spins anyway, and
     * then bakes whichever scenario was showing into a screenshot. So track
     * the query and act on the change.
     */
    let media: MediaQueryList | null = null;
    try {
      media = window.matchMedia('(prefers-reduced-motion: reduce)');
    } catch {
      media = null;
    }
    let reduceMotion = media?.matches ?? false;

    let index = 0;
    /* `ReturnType<typeof window.setInterval>` resolves to Node's `Timeout` here —
     * @types/node is in scope for the Astro frontmatter, and it wins over lib.dom.
     * This script only ever runs in the browser, where the handle is a number, so
     * say so. Same shape as `ReturnType<typeof setTimeout>` in apps/extension. */
    let timer: number | null = null;

    const setActive = (next: number): void => {
      index = next;

      tabs.forEach((tab, n) => {
        const active = n === next;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        const label = tab.querySelector<HTMLElement>('[data-drum-label]');
        label?.classList.toggle('text-accent-deep', active);
        label?.classList.toggle('text-ink-soft', !active);
      });

      panels.forEach((panel, n) => {
        panel.hidden = n !== next;
      });

      fills.forEach((fill, n) => {
        if (n !== next) {
          fill.classList.remove('w-full');
          fill.classList.add('w-0');
        }
      });

      // Reset-then-reflow-then-fill every time, even when re-selecting the
      // tab that was already active, so its bar restarts too. The
      // transition is dropped under prefers-reduced-motion by the
      // `motion-reduce:transition-none` class above, so this exact same
      // sequence lands instantly there instead of animating — no separate
      // branch needed for that half of the behaviour.
      const activeFill = fills[next];
      if (activeFill) {
        activeFill.classList.remove('w-full');
        activeFill.classList.add('w-0');
        void activeFill.offsetWidth;
        activeFill.classList.remove('w-0');
        activeFill.classList.add('w-full');
      }
    };

    const stop = (): void => {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const start = (): void => {
      stop();
      // Required, not optional: prefers-reduced-motion means no
      // auto-advance at all, not merely a slower one.
      if (reduceMotion) return;
      timer = window.setInterval(() => {
        setActive((index + 1) % tabs.length);
      }, ADVANCE_MS);
    };

    tabs.forEach((tab, n) => {
      tab.addEventListener('click', () => {
        setActive(n);
        start();
      });
    });

    setActive(0);
    start();

    /*
     * Turning the preference ON stops the drum where it stands rather than
     * rewinding it — the reader is looking at that scenario, and yanking it
     * back to the first one is itself a motion they did not ask for. Turning
     * it OFF resumes from there.
     */
    media?.addEventListener('change', () => {
      reduceMotion = media.matches;
      if (reduceMotion) stop();
      else start();
    });
  }
</script>
