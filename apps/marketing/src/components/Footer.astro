---
import { DISCORD_URL, FEEDBACK_URL, SOURCE_URL } from '@movar/brand';
import { socialLinks } from '../lib/social-links';
import {
  localeChangelogHref,
  localeHomeHref,
  localeHowMovarWorksHref,
  localeInstallHref,
  localePrivacyHref,
  localeTransparencyHref,
  localeWhyNotAiHref,
  strings,
  type Locale,
} from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = strings[lang].footer;
const home = localeHomeHref(lang);
const year = new Date().getFullYear();
const hero = strings[lang].hero;
const tagline = `${hero.headlineLine1} ${hero.headlineLine2}`;

/**
 * The ten destinations, grouped into the four columns the footer renders.
 *
 * One row stopped working at nine links: the Ukrainian set alone measured 637px
 * of a 1024px row at seven, and every further link either shrank the labels
 * until they folded mid-word or pushed the nav into a ragged second line under
 * the brand. Columns scale instead — an eleventh link lengthens a column rather
 * than re-flowing the whole footer.
 *
 * Grouped by what the visitor is here for, not by page type: get it, understand
 * it, decide whether to trust it, reach a human. `sourceCode` sits under "how it
 * works" because reading the code IS the deepest answer to that question.
 *
 * Contact holds the two channels that answer back — the support inbox and the
 * Discord server. Discord also has a mark in the social row below, and that
 * repetition is deliberate: the column is where you go to *ask* something, the
 * marks are where you go to *follow* along.
 *
 * `external` marks the links that leave the site (GitHub, Discord) and so open
 * in a new tab. `FEEDBACK_URL` is a `mailto:`, which the browser hands to a mail
 * client without navigating away — it deliberately gets no `target`.
 */
const columns = [
  {
    id: 'install',
    heading: t.groups.install,
    links: [
      { href: `${home}#download`, label: t.download, external: false },
      {
        href: localeInstallHref(lang),
        label: strings[lang].installGuide.linkLabel,
        external: false,
      },
      { href: localeChangelogHref(lang), label: t.changelog, external: false },
    ],
  },
  {
    id: 'understand',
    heading: t.groups.understand,
    links: [
      { href: localeHowMovarWorksHref(lang), label: t.howMovarWorks, external: false },
      // The short form ("Why no AI" / "Чому без ШІ"), not the page's own h1 —
      // a column is narrow, and the label reads as a question either way.
      {
        href: localeWhyNotAiHref(lang),
        label: strings[lang].whyNotAi.linkLabel,
        external: false,
      },
      { href: SOURCE_URL, label: t.sourceCode, external: true },
    ],
  },
  {
    id: 'trust',
    heading: t.groups.trust,
    links: [
      { href: localePrivacyHref(lang), label: t.privacy, external: false },
      { href: localeTransparencyHref(lang), label: t.transparency, external: false },
    ],
  },
  {
    id: 'contact',
    heading: t.groups.contact,
    links: [
      { href: FEEDBACK_URL, label: t.email, external: false },
      { href: DISCORD_URL, label: t.discord, external: true },
    ],
  },
] as const;
---

<footer class="mt-auto border-t border-border bg-surface px-6 py-8 text-sm text-ink-soft">
  <div class="mx-auto flex max-w-5xl flex-col gap-8">
    {/*
     * Brand on the left, the four link columns on the right — but only from lg
     * up. Four Ukrainian columns plus the brand block need the full 1024px row;
     * at sm the same five blocks left "Гід зі встановлення" folding mid-label,
     * which is the failure the row layout was replaced to avoid. Below lg the
     * brand stacks above a two-up grid instead (four columns wrap to 2 × 2).
     */}
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between lg:gap-10">
      {/*
       * The wordmark alone left the column an empty quarter of the row once
       * the links moved right, so it carries the tagline underneath — the same
       * canonical two-liner the hero and the OG card render, joined into one
       * sentence here rather than restated in footer-only copy.
       *
       * No max-width on that sentence: the Ukrainian set is the wider of the
       * two at 271px, which clears both the ~400px the brand column gets at lg
       * and the 327px content box of a 375px phone. Capping it (max-w-48) only
       * bought a gratuitous second line in the one place there was room.
       */}
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2">
          <img src="/icon.svg" alt="" width="20" height="20" class="rounded" />
          <span class="font-display font-bold text-ink-strong">movar.fyi</span>
        </div>
        <p class="text-ink-faint">{tagline}</p>
      </div>
      {/*
       * `w-max` sizes the 2 × 2 grid to its content instead of the full row.
       * Without it the two tracks are 1fr each, so at tablet widths the columns
       * drifted ~360px apart and read as two unrelated lists; `max-w-full`
       * keeps that from overflowing a narrow phone.
       */}
      <div class="grid w-max max-w-full grid-cols-2 gap-x-12 gap-y-8 lg:flex lg:w-auto lg:gap-x-10">
        {
          columns.map((column) => (
            <nav aria-labelledby={`footer-${column.id}`}>
              <h2
                id={`footer-${column.id}`}
                class="font-display text-xs font-bold uppercase tracking-label text-ink-faint"
              >
                {column.heading}
              </h2>
              {/*
               * `py-3` gives each label a 44px tap target on a phone; on a
               * desktop the padding collapses and the 8px list gap carries the
               * rhythm instead. `-mx-2 px-2` keeps the hover/focus box from
               * eating into the column's left edge.
               */}
              <ul class="mt-2 flex flex-col sm:mt-3 sm:gap-2">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                      class="-mx-2 inline-block px-2 py-3 transition hover:text-ink-strong sm:mx-0 sm:p-0"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>
    {/*
     * Legal and social close the footer under a rule, so the columns above read
     * as one block rather than four unrelated stacks.
     */}
    <div
      class="flex flex-col items-start gap-3 border-t border-border/60 pt-6 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
      <span>&copy; {year} {t.credits}</span>
      {/*
       * Social marks. Icon-only — the brand glyph is the label, so each link's
       * accessible name comes from `footer.social`. They stay out of the
       * columns above, which are text destinations. `-ml-2` / `sm:-mr-2` cancel
       * the tap-target padding on whichever edge the row is anchored to, so the
       * glyphs line up with the copyright on a phone and with the columns'
       * right edge on a desktop.
       */}
      <ul aria-label={t.social.label} class="-ml-2 flex items-center gap-1 sm:-mr-2 sm:ml-0">
        {
          socialLinks.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t.social[social.id]}
                class="inline-flex p-2 transition hover:text-ink-strong"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-5">
                  <path d={social.iconPath} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
