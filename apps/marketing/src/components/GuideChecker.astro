---
/*
 * The hub's two on-device widgets, in one island.
 *
 * 1. **Checker** — reads `navigator.languages` and says what the browser is
 *    asking sites for right now. This is the one thing on the page a reader
 *    can verify about themselves before changing anything, and it is why the
 *    guide opens with a diagnosis rather than a wall of links.
 * 2. **Detection** — guesses the visitor's OS and browser from the user agent
 *    and surfaces their own pages first.
 *
 * Both run entirely in the page: no requests, no storage, nothing recorded.
 * That is not incidental — the whole product's claim is that nothing leaves
 * your browser, and a marketing page that phoned home to tell you about your
 * language settings would be an odd way to make it.
 *
 * `navigator.languages` is the same list the browser serialises into
 * `Accept-Language`, so what the checker reports is what sites are told —
 * with the caveat the guide's own «Перевірка» page explains: Safari and
 * private windows deliberately send a shortened list.
 *
 * Rendered inert (`hidden`) and revealed by the script, so no-JS visitors see
 * the plain link list rather than a permanently "Перевіряємо…" box.
 */
import { guideStrings } from '../lib/guide';

const t = guideStrings;
---

<div
  data-guide-checker
  hidden
  class="mt-10 rounded-2xl border border-border bg-surface px-6 py-5"
>
  <p class="font-display text-xs font-bold uppercase tracking-label text-ink-faint">
    {t.checker.heading}
  </p>
  <p data-checker-verdict class="mt-3 text-lg text-ink-strong leading-relaxed"></p>
  <p class="mt-3 font-mono text-xs text-ink-faint">
    <span>{t.checker.listLabel}:</span>
    <span data-checker-list class="text-ink-soft"></span>
  </p>
</div>

<div data-guide-detect hidden class="mt-6">
  <p class="font-display text-sm font-bold text-ink-strong" data-detect-heading></p>
  <p class="mt-1 text-sm text-ink-soft">{t.detect.body}</p>
  <ul data-detect-links class="mt-3 flex flex-wrap gap-2"></ul>
</div>

<script>
  import { guideStrings } from '../lib/guide';

  const t = guideStrings;

  /* ---------------------------------------------------------------- checker */

  const box = document.querySelector<HTMLElement>('[data-guide-checker]');
  const verdictEl = document.querySelector<HTMLElement>('[data-checker-verdict]');
  const listEl = document.querySelector<HTMLElement>('[data-checker-list]');

  if (box && verdictEl && listEl) {
    const langs = navigator.languages?.length
      ? [...navigator.languages]
      : navigator.language
        ? [navigator.language]
        : [];

    // Compare on the primary subtag: `uk-UA` and `uk` are the same claim.
    const primary = (tag: string): string => tag.toLowerCase().split('-')[0] ?? '';
    const wantedIndex = langs.findIndex((tag) => primary(tag) === 'uk');
    const hasBlocked = langs.some((tag) => primary(tag) === 'ru');

    let verdict: string;
    if (langs.length === 0) verdict = t.checker.unavailable;
    else if (wantedIndex === -1) verdict = t.checker.missing;
    else if (hasBlocked) verdict = t.checker.hasBlocked;
    else if (wantedIndex > 0) verdict = t.checker.notFirst;
    else verdict = t.checker.good;

    verdictEl.textContent = verdict;
    listEl.textContent = langs.join(', ') || '—';
    box.hidden = false;
  }

  /* -------------------------------------------------------------- detection */

  /**
   * Guess OS and browser from the user agent. Order matters: Edge's UA also
   * says "Chrome", and every iOS browser's UA says "Safari" — which is
   * convenient rather than wrong here, since on iOS they genuinely all read
   * the same system language list.
   */
  function detect(): string[] {
    const ua = navigator.userAgent;
    const tokens: string[] = [];

    if (/iPhone|iPad|iPod/.test(ua)) tokens.push('ios');
    else if (/Android/.test(ua)) tokens.push('android');
    else if (/Mac OS X/.test(ua)) tokens.push('macos');
    else if (/Windows/.test(ua)) tokens.push('windows');

    if (/Edg\//.test(ua)) tokens.push('edge');
    else if (/Firefox\/|FxiOS/.test(ua)) tokens.push('firefox');
    else if (/Chrome\/|CriOS/.test(ua)) tokens.push('chrome');
    else if (/Safari\//.test(ua)) tokens.push('safari');

    return tokens;
  }

  const detectBox = document.querySelector<HTMLElement>('[data-guide-detect]');
  const headingEl = document.querySelector<HTMLElement>('[data-detect-heading]');
  const linksEl = document.querySelector<HTMLElement>('[data-detect-links]');

  if (detectBox && headingEl && linksEl) {
    const tokens = detect();
    // Every card carries its own match tokens; pick the ones that apply.
    const cards = [...document.querySelectorAll<HTMLAnchorElement>('[data-match]')].filter((card) =>
      (card.dataset['match'] ?? '')
        .split(' ')
        .filter(Boolean)
        .some((token) => tokens.includes(token)),
    );

    if (cards.length > 0) {
      const names = cards.map((card) => card.dataset['navLabel'] ?? '').filter(Boolean);
      headingEl.textContent = t.detect.heading.replace('{platform}', names.join(' і '));

      for (const card of cards) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = card.href;
        link.textContent = card.dataset['navLabel'] ?? '';
        link.className =
          'inline-flex items-center rounded-xl border border-accent bg-accent-surface px-4 py-2 text-sm font-semibold text-accent-deep transition hover:bg-accent hover:text-accent-on';
        item.append(link);
        linksEl.append(item);
      }

      detectBox.hidden = false;
    }
  }
</script>
