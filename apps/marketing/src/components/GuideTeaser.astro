---
/*
 * The homepage's door into the settings guide — Ukrainian-only, so it renders
 * on `/uk` and nowhere else. Rationale for its existence and for the shape of
 * its copy lives with the strings, in `lib/guide.ts` under `guideStrings.teaser`.
 *
 * ## What the script adds, and what it does not
 *
 * The band is complete without JavaScript: eyebrow, claim, mechanism, link. The
 * script adds one chip — how many faults this visitor's own language list
 * carries — read from `navigator.languages` in the page and sent nowhere, the
 * same reckoning `GuideChecker` runs on the hub and from the same module, so the
 * two can never disagree about the same browser.
 *
 * The chip is deliberately a verdict and not an explanation. The hub answers
 * "what exactly, and where do I fix it" in about a screen and a half; repeating
 * a paragraph of it here would make the homepage argue the guide's case instead
 * of opening its door.
 */
import { ChevronRight } from 'lucide-astro';

import { GUIDE_INDEX_HREF, guideStrings } from '../lib/guide';

const t = guideStrings.teaser;
---

<section id="language-list" class="border-t border-border bg-bg px-6 py-16">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-7 rounded-2xl border border-accent/30 bg-accent-surface p-8 md:flex-row md:items-center md:justify-between"
  >
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-semibold uppercase tracking-label text-accent-text">
        {t.eyebrow}
      </p>
      <h2
        class="mt-2 font-display text-2xl font-bold tracking-display text-ink-strong sm:text-3xl"
      >
        {t.heading}
      </h2>
      <p class="mt-3 text-ink-medium">{t.body}</p>
    </div>

    <div class="flex shrink-0 flex-col items-start gap-4 md:items-end">
      {/*
       * Empty and `hidden` until the script fills it. `role="status"` rather
       * than a live region with an assertive tone: it is a fact about the
       * reader's browser, not an alert, and it lands once on boot.
       */}
      <p
        data-guide-verdict
        hidden
        role="status"
        aria-label={t.verdictLabel}
        class="inline-flex items-center rounded-[var(--corner-chip)] border px-3 py-1.5 font-mono text-ui-micro font-semibold uppercase tracking-label"
      >
      </p>

      <a
        href={GUIDE_INDEX_HREF}
        class="inline-flex h-11 items-center gap-1 rounded-lg bg-accent px-5 font-semibold text-accent-on transition hover:bg-accent-deep"
      >
        {t.linkLabel}
        <ChevronRight class="size-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<script>
  import { diagnosisStrings, faultCountLabel, guideFaults, guideLanguages } from '../lib/guide-diagnosis';

  const chip = document.querySelector<HTMLElement>('[data-guide-verdict]');

  if (chip) {
    const tags = navigator.languages?.length
      ? [...navigator.languages]
      : navigator.language
        ? [navigator.language]
        : [];

    /*
     * "No data" is not "no faults": private windows and Safari hide the list
     * from the page on purpose, and a band that answered «Усе гаразд» there
     * would tell a reader their settings are fine on the strength of having
     * learned nothing about them. The list's own length is what separates the
     * two — see `guideFaults`, which returns an empty array for both.
     */
    const known = guideLanguages(tags).length > 0;
    const faults = guideFaults(tags);

    const TONES = {
      unknown: 'border-border bg-surface-2 text-ink-medium',
      clear: 'border-accent/30 bg-accent-soft text-accent-deep',
      faulty: 'border-danger-soft bg-danger-surface text-danger-deep',
    };

    const state = !known ? 'unknown' : faults.length === 0 ? 'clear' : 'faulty';

    chip.textContent = !known
      ? diagnosisStrings.count.unavailable
      : faults.length === 0
        ? diagnosisStrings.count.clear
        : faultCountLabel(faults.length);
    chip.className = `${chip.className} ${TONES[state]}`;
    chip.hidden = false;
  }
</script>
