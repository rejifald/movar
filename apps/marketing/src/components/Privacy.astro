---
/*
 * Privacy claim. Mint-tinted band sitting directly above the footer — the
 * last thing a reader sees before the site's fine print, so the claim closes
 * the page rather than opening a new topic.
 *
 * Restructured from a centered icon+paragraph card into a two-column band: a
 * heading anchors the left column; a lead paragraph, a wrapping row of claim
 * chips, and two links fill the right. `border-accent-soft bg-accent-surface`
 * for the band and `border-accent-soft bg-surface` for the chips both echo
 * the highlighted-card idiom already used in GuideChecker.astro's language
 * chips and GuideChecklist.astro's `#BEYOND_ANCHOR` card — same mint, same
 * "quiet card on a tinted band" construction, just at section scale.
 *
 * Below `md:` the heading sits left of a fixed-width column and the lead
 * fills the rest; above it, both stack full-width. `md:` (not `lg:`) because
 * this split reads fine already at a 768px tablet — there's no cramped
 * in-between width the way a narrower fixed column plus icon might have.
 *
 * The eyebrow reuses `nav.privacy` — just the word "Privacy"/"Приватність"
 * — rather than adding a new string for a label that only needs to name the
 * section.
 */
import { ServerOff, UserX, EyeOff, Gauge, FileCheck2 } from 'lucide-astro';

import { strings, type Locale, localePrivacyHref, localeTransparencyHref } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = strings[lang].privacy;
const eyebrow = strings[lang].nav.privacy;

// Same treatment as the hero's trust checklist: one icon per claim, each
// mapping to the thing it asserts rather than decorating it. Paired by name,
// not by index — see `PrivacyChips` in i18n.ts.
const chips = [
  { Icon: ServerOff, label: t.chips.servers },
  { Icon: UserX, label: t.chips.accounts },
  { Icon: EyeOff, label: t.chips.analytics },
  { Icon: Gauge, label: t.chips.speed },
  { Icon: FileCheck2, label: t.chips.verified },
];
---

<section id="privacy-callout" class="border-t border-accent-soft bg-accent-surface px-6 py-20">
  <div class="mx-auto flex max-w-5xl flex-col gap-8 md:flex-row md:items-start md:gap-10">
    <div class="md:w-96 md:shrink-0">
      <p class="font-mono text-xs font-semibold uppercase tracking-label text-accent-text">
        {eyebrow}
      </p>
      <h2
        class="mt-3 text-balance font-display text-3xl font-extrabold tracking-display text-ink-strong sm:text-4xl"
      >
        {t.sectionTitle}
      </h2>
    </div>

    <div class="min-w-0 flex-1">
      <p class="max-w-2xl leading-relaxed text-ink-soft">
        {t.sectionLead}
      </p>

      {/*
       * `items-start` with the icon nudged down by a half-step, because the
       * last claim is a full sentence that wraps at narrow widths while the
       * other four never do — centring would float its icon mid-paragraph.
       */}
      <ul class="mt-6 flex flex-col gap-3 border-t border-accent-soft pt-6">
        {
          chips.map(({ Icon, label }) => (
            <li class="flex items-start gap-2.5 text-sm text-ink-soft">
              <Icon class="mt-0.5 size-4 shrink-0 text-accent-text" aria-hidden="true" />
              {label}
            </li>
          ))
        }
      </ul>

      <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={localePrivacyHref(lang)}
          class="inline-flex items-center gap-1 text-sm font-semibold text-accent-text hover:underline"
        >
          {t.linkLabel}
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={`${localeTransparencyHref(lang)}#cant-spy`}
          class="inline-flex items-center gap-1 text-sm font-semibold text-accent-text hover:underline"
        >
          {t.safeguardsLabel}
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </div>
</section>
