---
/*
 * The block that closes every long-form page in the Ukrainian-only sections —
 * blog posts and guide pages alike: install Movar, then follow along.
 *
 * It is the one piece of chrome that is allowed to sell. The body of a post or
 * a guide page stays explanatory, and the pitch is quarantined here, after the
 * reader has finished.
 *
 * The pitch itself is a prop, because the two sections have earned different
 * closing arguments by the time a reader reaches the bottom. A post argues that
 * the internet keeps handing Ukrainian speakers Russian whatever they choose,
 * so the CTA acts on that argument. A guide page has just walked someone
 * through changing their own settings, so its CTA starts from what those
 * settings cannot reach. Defaults to the blog's, which is what every caller
 * wanted before the guide existed.
 *
 * Two tiers, in the order a convinced reader wants them: the install CTA, then
 * the follow channels. The first tier is optional — see `install` below for who
 * turns it off, and why.
 *
 * The CTA is the same browser-detecting button the hero and header use, via
 * `DownloadButtons`, so a page can never point at a store the rest of the site
 * has stopped recommending. It sits on a filled forest panel: with the guide
 * turning this tier off, a blog post is the only page that still renders it,
 * and it is that page's one loud surface. The panel is also the reason
 * `DownloadButtons` has an `inverse` tone at all — the green button would be a
 * 1.9:1 shape on its own background.
 *
 * `socialLinks` is shared with the
 * footer's icon row, so adding a network in `lib/social-links.ts` lands here
 * too; the feed is appended after it because RSS has no brand mark in that set
 * and, unlike the others, it is a link to this site rather than off it. The
 * follow half is deliberately NOT a prop: both sections point at the same
 * accounts and the same feed.
 */
import { Rss } from 'lucide-astro';
import { socialLinks } from '../lib/social-links';
import { BLOG_FEED_HREF, blogStrings } from '../lib/blog';
import DownloadButtons from './DownloadButtons.astro';

interface Props {
  /** The closing pitch. Omit for the blog's. */
  pitch?: { heading: string; body: string };
  /**
   * Whether the pitch tier renders at all.
   *
   * The guide turns it off, because there the same argument is already made
   * further up the page where it is actually read — beside the diagnosis, in
   * the checklist, and in each page's own callout — and a fourth install button
   * 700px below the third is not a second chance, it is noise. Those surfaces
   * carry the pitch; this one is left with the half they do not duplicate.
   */
  install?: boolean;
}

const { pitch = blogStrings.cta, install = true } = Astro.props;
const t = blogStrings;
---

<section data-reader-cta class="mt-20 border-t border-border pt-12">
  {
    install && (
      <div class="rounded-2xl bg-forest-900 px-6 py-12 sm:px-10">
        <h2 class="font-display text-3xl font-extrabold tracking-display text-white sm:text-4xl">
          {pitch.heading}
        </h2>
        <p class="mt-4 max-w-[58ch] text-[17px] leading-relaxed text-stone-200">{pitch.body}</p>

        <div class="mt-8">
          <DownloadButtons lang="uk" align="start" tone="inverse" />
        </div>
      </div>
    )
  }

  <div class:list={['text-center', install ? 'mt-10' : 'mt-0']}>
    <h2 class="font-display text-lg font-bold text-ink-strong">{t.subscribe.heading}</h2>
    <p class="mt-2 text-sm text-ink-soft">{t.subscribe.body}</p>

    <ul class="mt-5 flex items-center justify-center gap-3">
      {
        socialLinks.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t.subscribe[social.id]}
              class="inline-flex size-11 items-center justify-center rounded-xl border border-border bg-surface text-ink-soft transition hover:border-accent hover:text-accent-text"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-5">
                <path d={social.iconPath} />
              </svg>
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={BLOG_FEED_HREF}
          aria-label={t.subscribe.rss}
          class="inline-flex size-11 items-center justify-center rounded-xl border border-border bg-surface text-ink-soft transition hover:border-accent hover:text-accent-text"
        >
          <Rss class="size-5" aria-hidden="true" />
        </a>
      </li>
    </ul>
  </div>
</section>
