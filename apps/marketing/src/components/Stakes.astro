---
/*
 * "Why this matters": the closed-loop diagram (Fig. 1) plus the four theses
 * that unpack it. Rebuilt from the reference mock's sections 4 and 5, and
 * restyled as a "technical drawing plate": one bordered frame — corner
 * registration marks, a top ruler strip, a faint graph-paper ground — around
 * whichever of the two SVGs below is currently showing, with the caption
 * running as the plate's bottom label strip.
 *
 * Inside that one frame, the diagram is still drawn twice, swapped with
 * Tailwind visibility utilities:
 * - `wideBoxes`/the `md:block` SVG: four boxes left-to-right with the return
 *   path looping underneath. The box grid (width 230, 262px pitch) is lifted
 *   from the mock but generated from `diagram.nodes` instead of retyped four
 *   times.
 * - `narrowBoxes`/the `md:hidden` SVG: the same four nodes stacked
 *   top-to-bottom with the return path looping up a right-hand gutter
 *   instead of underneath. The wide geometry can't survive a 375px screen —
 *   scaled down it's unreadable, and a horizontal scroller would hide the
 *   return path, which is the whole point of the figure — so this is a
 *   different composition of the same argument, not a squashed copy. It also
 *   drops the wide drawing's dashed extension lines: there is no straight
 *   run here that wouldn't cross the rotated loop label.
 *
 * Both SVGs carry the SAME `role="img"` + aria-label. That is not a
 * duplicate: `hidden`/`md:hidden` is `display: none`, which drops an element
 * from the accessibility tree, so exactly one of the two is ever exposed.
 * Labelling only one would leave whichever breakpoint hides it with no
 * figure description at all.
 * The wide SVG also sits in a horizontally-scrolling wrapper with a min
 * width, so at the narrow end of its own (md-and-up) range it scrolls
 * instead of squashing past legibility.
 */
import { strings, type Locale, localeWhyThisHappensHref } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = strings[lang].stakes;

const diagram = t.diagram;

/** Columns the thesis grid runs at `md:` and up — see `md:grid-cols-2`. */
const COLS = 2;

// "Why this keeps happening" closes this section rather than the final CTA
// row: the four theses raise the question, and the deep dive is the answer.
// Label and destination are the retired Problem section's, unchanged.
const deepDiveLabel = strings[lang].problem.deepDiveLinkLabel;
const deepDiveHref = localeWhyThisHappensHref(lang);

/* ---- Wide diagram (md and up) ------------------------------------------ */
const WIDE_BOX_W = 230;
const WIDE_BOX_H = 84;
const WIDE_BOX_Y = 24;
const WIDE_PITCH = 262;

const wideBoxes = diagram.nodes.map((node, i) => ({ node, x: i * WIDE_PITCH }));
const wideArrows = wideBoxes.slice(0, 3).map(({ x }) => {
  const right = x + WIDE_BOX_W;
  const midY = WIDE_BOX_Y + WIDE_BOX_H / 2;
  return {
    line: `M${right + 4} ${midY} L${right + 24} ${midY}`,
    chevron: `M${right + 18} ${midY - 5} L${right + 24} ${midY} L${right + 18} ${midY + 5}`,
  };
});

// Every box, its numeral plate and the loop's ticks all share this edge.
const wideBoxBottom = WIDE_BOX_Y + WIDE_BOX_H; // 108

// Dashed extension lines drop from nodes 2 and 3 only: 1 and 4 already have
// the return path's own verticals passing their centres, so a second line
// there would just double up.
const wideExtensionLines = wideBoxes.slice(1, 3).map(({ x }) => {
  const cx = x + WIDE_BOX_W / 2;
  return `M${cx} ${wideBoxBottom + 4} L${cx} 244`;
});

// The return path's two ends are the horizontal centres of box 1 and box 4.
const wideLoopEnd = WIDE_BOX_W / 2; // 115
const wideLoopStart = 3 * WIDE_PITCH + WIDE_BOX_W / 2; // 901
const wideLoopRunY = 232; // the path's horizontal run, underneath the boxes

// The path splits around the pill label below (unchanged: x=424 width=180),
// clearing 16px on each side of its centre.
const wideLoopLabelCx = 424 + 180 / 2; // 514
const wideLoopLabelHalfGap = 180 / 2 + 16; // 106
const wideLoopGapRight = wideLoopLabelCx + wideLoopLabelHalfGap; // 620
const wideLoopGapLeft = wideLoopLabelCx - wideLoopLabelHalfGap; // 408

const wideLoopTick = `M${wideLoopStart - 8} ${wideBoxBottom} L${wideLoopStart + 8} ${wideBoxBottom}`;
const wideLoopSegA = `M${wideLoopStart} ${wideBoxBottom} L${wideLoopStart} ${wideLoopRunY} L${wideLoopGapRight} ${wideLoopRunY}`;
const wideLoopSegB = `M${wideLoopGapLeft} ${wideLoopRunY} L${wideLoopEnd} ${wideLoopRunY} L${wideLoopEnd} ${wideBoxBottom + 14}`;
const wideLoopArrowhead = `M${wideLoopEnd - 7} ${wideBoxBottom + 14} L${wideLoopEnd} ${wideBoxBottom} L${wideLoopEnd + 7} ${wideBoxBottom + 14} Z`;

/* ---- Narrow diagram (below md) ------------------------------------------ */
const NARROW_BOX_W = 230;
const NARROW_BOX_H = 84;
const NARROW_GAP = 70;
const NARROW_TOP = 26;
const NARROW_GUTTER_X = 278;
const NARROW_VIEW_W = 300;

const narrowBoxY = (i: number) => NARROW_TOP + i * (NARROW_BOX_H + NARROW_GAP);
const narrowBoxes = diagram.nodes.map((node, i) => ({ node, y: narrowBoxY(i) }));
const NARROW_VIEW_H = narrowBoxY(3) + NARROW_BOX_H + NARROW_TOP;

const narrowArrows = [0, 1, 2].map((i) => {
  const cx = NARROW_BOX_W / 2;
  const bottom = narrowBoxY(i) + NARROW_BOX_H + 10;
  const tip = narrowBoxY(i + 1) - 10;
  return {
    line: `M${cx} ${bottom} L${cx} ${tip}`,
    chevron: `M${cx - 5} ${tip - 6} L${cx} ${tip} L${cx + 5} ${tip - 6}`,
  };
});

const narrowExitY = narrowBoxY(3) + NARROW_BOX_H / 2;
const narrowEntryY = narrowBoxY(0) + NARROW_BOX_H / 2;
// Pill sits centred between the two ends it labels, rotated so its text reads
// parallel to the return path it's labelling.
const narrowPillCenterY = (narrowEntryY + narrowExitY) / 2;
const narrowLoopHalfGap = 78; // label half-span + clearance, mirrors the wide drawing's gap

const narrowLoopTick = `M${NARROW_BOX_W} ${narrowExitY - 8} L${NARROW_BOX_W} ${narrowExitY + 8}`;
const narrowLoopSegA = `M${NARROW_BOX_W} ${narrowExitY} L${NARROW_GUTTER_X} ${narrowExitY} L${NARROW_GUTTER_X} ${narrowPillCenterY + narrowLoopHalfGap}`;
const narrowLoopSegB = `M${NARROW_GUTTER_X} ${narrowPillCenterY - narrowLoopHalfGap} L${NARROW_GUTTER_X} ${narrowEntryY} L${NARROW_BOX_W + 14} ${narrowEntryY}`;
const narrowLoopArrowhead = `M${NARROW_BOX_W + 14} ${narrowEntryY - 7} L${NARROW_BOX_W} ${narrowEntryY} L${NARROW_BOX_W + 14} ${narrowEntryY + 7} Z`;
---

<section id="why-it-matters" class="border-t border-border bg-bg px-6 py-20">
  <div class="mx-auto max-w-5xl">
    <div class="max-w-3xl">
      <p class="font-display text-xs font-bold uppercase tracking-label text-accent-text">
        {t.sectionTitle}
      </p>
      <h2
        class="mt-3 font-display text-3xl font-extrabold tracking-display text-ink-strong sm:text-4xl"
      >
        {t.sectionLead}
      </h2>
    </div>

    <figure class="mt-9 border border-border-strong bg-surface p-2">
      <div class="plate relative border border-border p-4 sm:p-6">
        {/* Corner registration marks + a top ruler strip — the "technical
            drawing plate" framing device. Purely decorative. */}
        <span
          aria-hidden="true"
          class="absolute -left-px -top-px size-[9px] border-l border-t border-[var(--plate-mark)]"
        />
        <span
          aria-hidden="true"
          class="absolute -right-px -top-px size-[9px] border-r border-t border-[var(--plate-mark)]"
        />
        <span
          aria-hidden="true"
          class="absolute -bottom-px -left-px size-[9px] border-b border-l border-[var(--plate-mark)]"
        />
        <span
          aria-hidden="true"
          class="absolute -bottom-px -right-px size-[9px] border-b border-r border-[var(--plate-mark)]"
        />
        <div aria-hidden="true" class="plate-ruler h-[4px]" />

        {/* Wide (md and up): four boxes left-to-right, loop underneath.
            Scrolls horizontally rather than squashing below a legible size. */}
        <div class="mt-4 hidden overflow-x-auto md:block">
          <svg
            viewBox="0 0 1040 254"
            width="100%"
            class="min-w-[var(--diagram-min-w)]"
            role="img"
            aria-label={diagram.ariaLabel}
          >
            <g fill="var(--surface)" stroke="var(--border-strong)" stroke-width="1">
              {wideBoxes.map(({ x }) => (
                <rect x={x} y="2" width="22" height="16" rx="1" />
              ))}
            </g>
            <g stroke="var(--border-strong)" stroke-width="1" fill="none">
              {wideBoxes.map(({ x }) => (
                <path d={`M${x + 11} 18 L${x + 11} ${WIDE_BOX_Y}`} />
              ))}
            </g>
            <g font-family="var(--font-mono)" font-size="10" fill="var(--ink-faint)">
              {wideBoxes.map(({ x }, i) => (
                <text x={x + 11} y="14" text-anchor="middle">
                  {String(i + 1).padStart(2, '0')}
                </text>
              ))}
            </g>

            <g fill="var(--surface)" stroke="var(--border-strong)" stroke-width="1">
              {wideBoxes.map(({ x }) => (
                <rect x={x} y={WIDE_BOX_Y} width={WIDE_BOX_W} height={WIDE_BOX_H} rx="2" />
              ))}
            </g>

            <g
              font-family="var(--font-sans)"
              font-size="15"
              font-weight="600"
              letter-spacing="-0.2"
              fill="var(--ink-strong)"
            >
              {wideBoxes.map(({ x, node }) => (
                <>
                  <text x={x + 20} y={WIDE_BOX_Y + 36}>
                    {node.heading[0]}
                  </text>
                  <text x={x + 20} y={WIDE_BOX_Y + 56}>
                    {node.heading[1]}
                  </text>
                </>
              ))}
            </g>
            <g
              stroke="var(--ink-faint)"
              stroke-width="1.4"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              {wideArrows.map((arrow) => (
                <>
                  <path d={arrow.line} />
                  <path d={arrow.chevron} />
                </>
              ))}
            </g>

            <g stroke="var(--border)" stroke-width="1" stroke-dasharray="3 4" fill="none">
              {wideExtensionLines.map((d) => (
                <path d={d} />
              ))}
            </g>

            <g
              stroke="var(--accent)"
              stroke-width="1.8"
              fill="none"
              stroke-linecap="butt"
              stroke-linejoin="miter"
            >
              <path d={wideLoopTick} />
              <path d={wideLoopSegA} />
              <path d={wideLoopSegB} />
            </g>
            <path d={wideLoopArrowhead} fill="var(--accent)" />

            <rect
              x="424"
              y="218"
              width="180"
              height="28"
              rx="14"
              fill="var(--accent-surface)"
              stroke="var(--accent-soft)"
              stroke-width="1"
            />
            <text
              x="514"
              y="236"
              text-anchor="middle"
              font-family="var(--font-sans)"
              font-size="13"
              font-weight="700"
              letter-spacing="-0.2"
              fill="var(--accent-deep)"
            >
              {diagram.loopLabel}
            </text>
          </svg>
        </div>

        {/* Below md: same four nodes stacked, return path up the right
            gutter. Carries the same accessible name as the wide SVG — see
            the file header for why that is not a duplicate. */}
        <div class="mt-4 md:hidden">
          <svg
            viewBox={`0 0 ${NARROW_VIEW_W} ${NARROW_VIEW_H}`}
            width="100%"
            role="img"
            aria-label={diagram.ariaLabel}
          >
            <g fill="var(--surface)" stroke="var(--border-strong)" stroke-width="1">
              {narrowBoxes.map(({ y }) => (
                <rect x="0" y={y - 22} width="22" height="16" rx="1" />
              ))}
            </g>
            <g stroke="var(--border-strong)" stroke-width="1" fill="none">
              {narrowBoxes.map(({ y }) => (
                <path d={`M11 ${y - 6} L11 ${y}`} />
              ))}
            </g>
            <g font-family="var(--font-mono)" font-size="10" fill="var(--ink-faint)">
              {narrowBoxes.map(({ y }, i) => (
                <text x="11" y={y - 10} text-anchor="middle">
                  {String(i + 1).padStart(2, '0')}
                </text>
              ))}
            </g>

            <g fill="var(--surface)" stroke="var(--border-strong)" stroke-width="1">
              {narrowBoxes.map(({ y }) => (
                <rect x="0" y={y} width={NARROW_BOX_W} height={NARROW_BOX_H} rx="2" />
              ))}
            </g>

            <g
              font-family="var(--font-sans)"
              font-size="15"
              font-weight="600"
              letter-spacing="-0.2"
              fill="var(--ink-strong)"
            >
              {narrowBoxes.map(({ y, node }) => (
                <>
                  <text x="20" y={y + 36}>
                    {node.heading[0]}
                  </text>
                  <text x="20" y={y + 56}>
                    {node.heading[1]}
                  </text>
                </>
              ))}
            </g>
            <g
              stroke="var(--ink-faint)"
              stroke-width="1.4"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              {narrowArrows.map((arrow) => (
                <>
                  <path d={arrow.line} />
                  <path d={arrow.chevron} />
                </>
              ))}
            </g>

            <g
              stroke="var(--accent)"
              stroke-width="1.8"
              fill="none"
              stroke-linecap="butt"
              stroke-linejoin="miter"
            >
              <path d={narrowLoopTick} />
              <path d={narrowLoopSegA} />
              <path d={narrowLoopSegB} />
            </g>
            <path d={narrowLoopArrowhead} fill="var(--accent)" />

            <g transform={`rotate(-90 ${NARROW_GUTTER_X} ${narrowPillCenterY})`}>
              <rect
                x={NARROW_GUTTER_X - 70}
                y={narrowPillCenterY - 14}
                width="140"
                height="28"
                rx="14"
                fill="var(--accent-surface)"
                stroke="var(--accent-soft)"
                stroke-width="1"
              />
              <text
                x={NARROW_GUTTER_X}
                y={narrowPillCenterY + 4.5}
                text-anchor="middle"
                font-family="var(--font-sans)"
                font-size="12"
                font-weight="700"
                letter-spacing="-0.2"
                fill="var(--accent-deep)"
              >
                {diagram.loopLabel}
              </text>
            </g>
          </svg>
        </div>

        <figcaption
          class="-mx-4 -mb-4 mt-4 border-t border-border bg-surface px-4 py-3 text-sm leading-relaxed text-ink-faint sm:-mx-6 sm:-mb-6 sm:px-6"
        >
          {diagram.caption}
        </figcaption>
      </div>
    </figure>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-2">
      {
        t.facts.map((fact, i) => {
          /* Derived from the list length rather than assuming four. The rules
             do double duty: stacked, `border-b` separates consecutive items;
             two-up, it becomes the divider between rows, so the last row drops
             it. A single row (two facts) therefore has no horizontal rule at
             all, only the vertical one between the columns. */
          const isLeftCol = i % COLS === 0;
          const isFirstRow = i < COLS;
          const isLastRow = i >= t.facts.length - (t.facts.length % COLS || COLS);
          return (
            <div
              class:list={[
                'py-8 md:py-0',
                i < t.facts.length - 1 ? 'border-b border-border' : '',
                isLastRow ? 'md:border-b-0' : 'md:pb-9',
                isFirstRow ? '' : 'md:pt-9',
                isLeftCol ? 'md:border-r md:border-border md:pr-11' : 'md:pl-11',
              ]}
            >
              <div class="flex gap-5">
                <span
                  class="shrink-0 pt-1 font-mono text-sm text-ink-faint"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-display text-xl font-bold leading-snug text-ink-strong">
                    {fact.heading}
                  </h3>
                  <p class="mt-2.5 leading-relaxed text-ink-soft">{fact.body}</p>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <a
      href={deepDiveHref}
      class="mt-10 inline-flex items-center gap-1 text-sm font-semibold text-accent-text hover:underline"
    >
      {deepDiveLabel}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .plate {
    background-image:
      repeating-linear-gradient(to right, var(--surface-2) 0 1px, transparent 1px 26px),
      repeating-linear-gradient(to bottom, var(--surface-2) 0 1px, transparent 1px 26px);
  }
  .plate-ruler {
    background-image: repeating-linear-gradient(to right, var(--border) 0 1px, transparent 1px 52px);
  }
</style>
