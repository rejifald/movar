---
/*
 * Blog index — the list of posts. Ukrainian-only; see `src/content.config.ts`
 * for why this section has no English twin and what that implies for the
 * layout (`localeAlternates={false}`) and the edge middleware (no entry).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import {
  BLOG_FEED_HREF,
  blogPostHref,
  blogStrings,
  formatPostDate,
  isPublished,
  sortPostsByDate,
} from '../../../lib/blog';

const lang = 'uk';
const t = blogStrings;

const posts = sortPostsByDate(await getCollection('blog', isPublished));
---

<BaseLayout
  lang={lang}
  title={t.index.pageTitle}
  description={t.index.pageDescription}
  localeAlternates={false}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={t.feed.title} href={BLOG_FEED_HREF} />
  </Fragment>
  <Header lang={lang} />
  <main class="flex-1 px-6 py-16">
    <div class="mx-auto max-w-3xl">
      <p class="font-display text-xs font-bold uppercase tracking-label text-accent-text">
        {t.navLabel}
      </p>
      <h1
        class="mt-2 font-display text-4xl font-extrabold tracking-display text-ink-strong sm:text-5xl"
      >
        {t.index.title}
      </h1>
      <p class="mt-6 text-lg text-ink-soft leading-relaxed">{t.index.lead}</p>

      <ul aria-label={t.index.listLabel} class="mt-12 space-y-6">
        {
          posts.map((post) => (
            <li>
              <a
                href={blogPostHref(post.id)}
                class="group block rounded-2xl border border-border bg-surface px-6 py-6 transition hover:border-accent hover:shadow-md"
              >
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="font-mono text-xs uppercase tracking-label text-ink-faint tabular-nums"
                >
                  {formatPostDate(post.data.pubDate)}
                </time>
                <h2 class="mt-2 font-display text-2xl font-bold text-ink-strong transition group-hover:text-accent-text">
                  {post.data.title}
                </h2>
                <p class="mt-3 text-ink-soft leading-relaxed">{post.data.lead}</p>
                <p class="mt-4 text-sm font-semibold text-accent-text">
                  {t.index.readMore}
                  <span aria-hidden="true">→</span>
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
