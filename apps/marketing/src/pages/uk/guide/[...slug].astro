---
/*
 * One guide page — a single platform's steps, and nothing else.
 *
 * Deliberately spare: back-link, title, «оновлено» stamp, the steps, then the
 * neighbouring pages in the same group. No framing, no three rules, no
 * preamble — the hub carries all of that, and a reader who landed here from a
 * search wants the steps above the fold.
 *
 * The `updated` stamp is not decoration. Every vendor in this guide moves its
 * menus, so a set of instructions with no date is a set of instructions you
 * cannot judge.
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ReaderCta from '../../../components/ReaderCta.astro';
import GuideCallout from '../../../components/GuideCallout.astro';
import {
  GUIDE_GROUPS,
  GUIDE_INDEX_HREF,
  formatUpdated,
  guidePageHref,
  guideStrings,
} from '../../../lib/guide';

interface Props {
  page: CollectionEntry<'guide'>;
  siblings: CollectionEntry<'guide'>[];
}

export const getStaticPaths: GetStaticPaths = async () => {
  const pages = await getCollection('guide');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: {
      page,
      // The rest of this page's group, in order — the natural "what else is
      // in front of me" list for someone who just fixed one platform.
      siblings: pages
        .filter((other) => other.data.group === page.data.group && other.id !== page.id)
        .toSorted((a, b) => a.data.order - b.data.order),
    },
  }));
};

const { page, siblings } = Astro.props;
const { Content } = await render(page);

const lang = 'uk';
const t = guideStrings;

/* The group this page belongs to, named. `group` is a `z.enum` of exactly the
 * `GUIDE_GROUPS` ids, so the lookup cannot miss — the fallback is there for the
 * type, not for a case that can happen. */
const siblingsHeading = t.page.siblingsHeading.replace(
  '{group}',
  GUIDE_GROUPS.find((group) => group.id === page.data.group)?.heading ?? '',
);
---

<BaseLayout
  lang={lang}
  title={`${page.data.title} — Movar`}
  description={page.data.description}
  localeAlternates={false}
  ogType="article"
>
  <Header lang={lang} />
  <main id="main" tabindex="-1" class="flex-1 px-6 py-16">
    <article class="mx-auto max-w-3xl">
      <a
        href={GUIDE_INDEX_HREF}
        class="inline-flex items-center gap-1 font-display text-xs font-bold uppercase tracking-label text-accent-text transition hover:text-ink-strong"
      >
        <span aria-hidden="true">←</span>
        {t.page.backToIndex}
      </a>

      <h1
        class="mt-4 font-display text-3xl font-extrabold tracking-display text-ink-strong sm:text-4xl"
      >
        {page.data.title}
      </h1>

      <p class="mt-4 font-mono text-xs uppercase tracking-label text-ink-faint tabular-nums">
        {t.page.updated}
        <time datetime={page.data.updated.toISOString()}>{formatUpdated(page.data.updated)}</time>
      </p>

      <div class="article-prose mt-10">
        <Content />
      </div>

      <GuideCallout movar={page.data.movar} />

      {/* The rest of this page's group.
          Cards rather than the bare pills this used to be: a pill reading
          «Firefox» tells a reader nothing they did not already know, and gives
          them nothing to choose on. The card is the hub's own shape, carrying
          the same `description` the hub shows — so the four platform pages in
          a group are told apart by what they contain rather than by a brand
          name. See `page.siblingsHeading` for why the heading names the group
          instead of saying «Далі». */}
      {
        siblings.length > 0 && (
          <nav class="mt-16 border-t border-border pt-8">
            <h2 class="font-display text-xs font-bold uppercase tracking-label text-ink-faint">
              {siblingsHeading}
            </h2>
            <ul class="mt-5 grid gap-3 sm:grid-cols-2">
              {siblings.map((sibling) => (
                <li>
                  <a
                    href={guidePageHref(sibling.id)}
                    class="flex h-full flex-col rounded-xl border border-border bg-surface px-5 py-4 transition hover:border-accent hover:shadow-md"
                  >
                    <span class="font-display font-bold text-ink-strong">
                      {sibling.data.navLabel}
                    </span>
                    <span class="mt-1 text-sm text-ink-soft">{sibling.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <ReaderCta install={false} />
    </article>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<script>
  /*
   * Progressive enhancement for every `hidden-words` block a page's body may
   * contain — see `src/lib/hidden-words.ts` for the markup contract each
   * block renders to, and `plugins/remark-hidden-words.mjs` for where that
   * markup comes from. Pure DOM: the word lists themselves are already in
   * the static HTML by the time this runs, so the script only ever reads
   * what render produced and imports nothing from the data module — a
   * no-JS visitor already sees every word, just without a copy button.
   *
   * No-op without a `[data-hidden-words]` block (most guide pages have
   * none) and idempotent: `data-wired` marks a block once it is set up, so
   * running this twice cannot double-bind a click handler.
   */
  const COPIED_MS = 1600;

  /**
   * Writes to the clipboard, swallowing every way it can fail: a rejected
   * permission, an insecure context, or the API simply not existing (the
   * property access throws before the `await`, and a synchronous throw
   * inside a `try` in an async function is caught exactly like an async
   * rejection). Callers fall back to select-to-copy on `false` — a refusal
   * must never swallow the click.
   */
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  function selectContents(node: Element): void {
    const range = document.createRange();
    range.selectNodeContents(node);
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  }

  /** The `paste`-format block: unhide its button, and wire one whole-text copy. */
  function wirePaste(block: HTMLElement): void {
    const text = block.querySelector<HTMLElement>('[data-hidden-words-text]');
    const button = block.querySelector<HTMLButtonElement>('[data-hidden-words-copy]');
    if (!text || !button) return;

    button.hidden = false;
    const idleLabel = button.textContent ?? '';
    const copiedLabel = button.dataset['copiedLabel'] ?? idleLabel;

    button.addEventListener('click', () => {
      void copyText(text.textContent ?? '')
        .then((copied) => {
          if (!copied) {
            // Refused or unavailable — leave the reader something to select
            // and copy by hand rather than swallowing the click.
            selectContents(text);
            return;
          }
          button.textContent = copiedLabel;
          window.setTimeout(() => {
            button.textContent = idleLabel;
          }, COPIED_MS);
        })
        .catch(() => {
          /* copyText() never rejects; belt-and-suspenders. */
        });
    });
  }

  /** The `entries`-format block: upgrade each word chip into its own copy button. */
  function wireEntries(block: HTMLElement): void {
    const copyLabel = block.dataset['copyLabel'] ?? '';
    const copiedLabel = block.dataset['copiedLabel'] ?? copyLabel;
    const status = block.querySelector<HTMLElement>('[data-hidden-words-status]');

    for (const entry of block.querySelectorAll<HTMLElement>('[data-hidden-words-entry]')) {
      const word = entry.textContent ?? '';

      const button = document.createElement('button');
      button.type = 'button';
      button.className = entry.className;
      button.setAttribute('data-hidden-words-entry', '');
      button.textContent = word;
      button.setAttribute('aria-label', `${copyLabel}: ${word}`);
      entry.replaceWith(button);

      button.addEventListener('click', () => {
        void copyText(word)
          .then((copied) => {
            if (!copied) {
              // Refused or unavailable — same fallback as the paste block:
              // let the reader select and copy the word by hand.
              selectContents(button);
              return;
            }
            button.toggleAttribute('data-copied', true);
            // Includes the word, not just the bare label: two consecutive
            // copies of DIFFERENT entries must change the live region's text
            // to be re-announced — identical text is not re-read.
            if (status) status.textContent = `${copiedLabel}: ${word}`;
            window.setTimeout(() => {
              button.toggleAttribute('data-copied', false);
            }, COPIED_MS);
          })
          .catch(() => {
            /* copyText() never rejects; belt-and-suspenders. */
          });
      });
    }
  }

  for (const block of document.querySelectorAll<HTMLElement>('[data-hidden-words]')) {
    if (block.hasAttribute('data-wired')) continue;
    block.setAttribute('data-wired', '');

    if (block.dataset['format'] === 'paste') wirePaste(block);
    else wireEntries(block);
  }
</script>
