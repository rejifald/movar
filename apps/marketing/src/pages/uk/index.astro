---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Coverage from '../../components/Coverage.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Stakes from '../../components/Stakes.astro';
import GuideTeaser from '../../components/GuideTeaser.astro';
import Close from '../../components/Close.astro';
import Privacy from '../../components/Privacy.astro';
import Contribute from '../../components/Contribute.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout lang="uk">
  <Header lang="uk" />
  <main id="main" tabindex="-1" class="flex-1">
    <Hero lang="uk" />
    <Coverage lang="uk" />
    <HowItWorks lang="uk" />
    <Stakes lang="uk" />
    {/*
     * Ukrainian-only, because the guide it opens is (see `lib/guide.ts`), so
     * `/` renders one section fewer rather than linking an English reader to
     * twenty pages of Ukrainian prose.
     *
     * Placed after Stakes and before the install CTA: Stakes is where the
     * reader is told the problem is real, and this is where they are shown it
     * in their own browser. `Close.astro` records that a second link *inside*
     * its row competed with the install button and was moved out — a band of
     * its own above that row is the version of this that does not.
     */}
    <GuideTeaser />
    <Close lang="uk" />
    <Privacy lang="uk" />
    <Contribute lang="uk" />
  </main>
  <Footer lang="uk" />
</BaseLayout>
