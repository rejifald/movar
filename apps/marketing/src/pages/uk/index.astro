---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Coverage from '../../components/Coverage.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Stakes from '../../components/Stakes.astro';
import GuideTeaser from '../../components/GuideTeaser.astro';
import Close from '../../components/Close.astro';
import Privacy from '../../components/Privacy.astro';
import Contribute from '../../components/Contribute.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout lang="uk">
  <Header lang="uk" />
  <main id="main" tabindex="-1" class="flex-1">
    <Hero lang="uk" />
    <Coverage lang="uk" />
    {/*
     * Ukrainian-only, because the guide it opens is (see `lib/guide.ts`), so
     * `/` renders one section fewer rather than linking an English reader to
     * twenty pages of Ukrainian prose.
     *
     * Placed here after two earlier positions, and the constraint is the same
     * one both times: this section's only link leaves the home page, so it must
     * not stand next to a call to action it can take readers away from.
     *
     * Below `Stakes` it sat in a 609px run of three consecutive asks with the
     * install CTA in the middle of them. Directly under `Hero` it would do the
     * same thing to the hero's own install button, one scroll in, before a
     * reader knows what Movar is. `Coverage` is the one section on the page
     * with no links of its own, so the exit here is uncontested — and this is
     * ~1150px higher than the Stakes seam it gave up, which is the point of the
     * whole change.
     */
    <GuideTeaser />
    <HowItWorks lang="uk" />
    <Stakes lang="uk" />
    <Close lang="uk" />
    <Privacy lang="uk" />
    <Contribute lang="uk" />
  </main>
  <Footer lang="uk" />
</BaseLayout>
