---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Coverage from '../../components/Coverage.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Stakes from '../../components/Stakes.astro';
import GuideTeaser from '../../components/GuideTeaser.astro';
import Close from '../../components/Close.astro';
import Privacy from '../../components/Privacy.astro';
import Contribute from '../../components/Contribute.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout lang="uk">
  <Header lang="uk" />
  <main id="main" tabindex="-1" class="flex-1">
    <Hero lang="uk" />
    <Coverage lang="uk" />
    <HowItWorks lang="uk" />
    {/*
     * Ukrainian-only, because the guide it opens is (see `lib/guide.ts`), so
     * `/` renders one section fewer rather than linking an English reader to
     * twenty pages of Ukrainian prose.
     *
     * It sits here, and not in front of `Close`, because of what it argues.
     * `HowItWorks` has just finished naming Movar's two steps; this names their
     * boundary — the language list Movar does not set — which continues that
     * section rather than interrupting the page. Its neighbours are the two
     * longest blocks here (~1150px and ~950px), so a 350px band reads as a beat
     * between them.
     *
     * Below Stakes it did the opposite. Stakes closes with the deep-dive link
     * and `Close` opens with the install button, and dropping a third CTA into
     * that 609px meant three asks in a row with the page's one conversion
     * moment in the middle of them — the same mistake `Close.astro` records
     * having already made once, when a second link inside its own row competed
     * with the install button and had to be moved out.
     */}
    <GuideTeaser />
    <Stakes lang="uk" />
    <Close lang="uk" />
    <Privacy lang="uk" />
    <Contribute lang="uk" />
  </main>
  <Footer lang="uk" />
</BaseLayout>
