---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhyNotAi from '../components/WhyNotAi.astro';
import { strings } from '../i18n';

const t = strings.en.whyNotAi;
---

<BaseLayout lang="en" title={t.pageTitle} description={t.pageDescription}>
  <Header lang="en" />
  <main id="main" tabindex="-1" class="flex-1">
    <WhyNotAi lang="en" />
  </main>
  <Footer lang="en" />
</BaseLayout>
