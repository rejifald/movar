---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import DeepDive from '../components/DeepDive.astro';
import Footer from '../components/Footer.astro';
import { strings } from '../i18n';

const lang = 'en';
const t = strings[lang].whyThisHappens;
---

<BaseLayout lang={lang} title={t.pageTitle} description={t.pageDescription}>
  <Header lang={lang} />
  <main id="main" tabindex="-1" class="flex-1 px-6 py-16">
    <DeepDive t={t} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
