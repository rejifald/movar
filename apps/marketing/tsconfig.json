{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "verbatimModuleSyntax": false,
    "noEmit": true,
    // The transparency page imports the shared promise-verification module by its
    // explicit `.mts` path (vite resolves the literal file; tsc needs this flag to
    // accept a TS extension in an import). Safe here — this project never emits.
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "types": ["astro/client"]
  },
  // `scripts/` and `plugins/` are here for the same reason `src/` is: they
  // ship behaviour. The chart generator, its freshness check and the remark
  // plugin that inlines what they write sat outside every `include` in the
  // repo, so `astro check` never opened them and `tsx` only transpiles — a
  // script could reference a figure that no longer exists and nothing would
  // say so until someone ran it. `allowJs` without `checkJs` means the `.mjs`
  // plugins are parsed for inference but not reported on, which is the right
  // amount for a file with no annotations to check.
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "plugins/**/*", "astro.config.mjs"],
  "exclude": ["dist", "node_modules"]
}
